---
interface Props {
  mp4: string;
  webm?: string;
  poster: string;
  label?: string;
  caption: string;
  width: number;
  height: number;
}

const {
  mp4,
  webm,
  poster,
  label,
  caption,
  width,
  height,
} = Astro.props;

const aspect = width / height;
---

<figure
  class="home-evidence home-evidence--video"
  data-video-evidence
>
  {
    label && (
      <p class="home-evidence__label">{label}</p>
    )
  }
  <button
    class="home-evidence__expand"
    type="button"
    aria-label={`Expand video: ${label ?? caption}`}
    data-video-evidence-open
  >
    <video
      class="home-evidence__video"
      autoplay
      muted
      loop
      playsinline
      poster={poster}
      width={width}
      height={height}
      data-video-evidence-inline
    >
      {
        webm && (
          <source src={webm} type="video/webm" />
        )
      }
      <source src={mp4} type="video/mp4" />
    </video>
    <span
      class="home-evidence__expand-hint"
      aria-hidden="true"
    >
      <svg
        class="home-evidence__expand-icon"
        viewBox="0 0 24 24"
      >
        <path
          d="M15 3h6v6M21 3l-7 7M9 21H3v-6M3 21l7-7"
        ></path>
      </svg>
      <span class="home-evidence__expand-word">
        Expand
      </span>
    </span>
    <span
      class="home-evidence__timecode"
      aria-hidden="true"
    >
      <svg
        class="home-evidence__timecode-icon"
        viewBox="0 0 24 24"
      >
        <path d="M7 4.5 19.5 12 7 19.5Z"></path>
      </svg>
      <span data-video-evidence-timecode>
        0:00
      </span>
    </span>
  </button>

  <dialog
    class="home-lightbox home-lightbox--video"
    aria-label={caption}
    style={`--home-lightbox-aspect: ${aspect}`}
    data-video-evidence-dialog
  >
    <div class="home-lightbox__frame">
      <button
        class="home-lightbox__close"
        type="button"
        aria-label="Close expanded video"
        title="Close"
        data-video-evidence-close
      >
        <svg
          class="home-lightbox__close-icon"
          aria-hidden="true"
          viewBox="0 0 24 24"
        >
          <path d="M18 6 6 18M6 6l12 12"></path>
        </svg>
      </button>
      <div class="home-lightbox__figure">
        <video
          class="home-lightbox__video"
          controls
          playsinline
          preload="metadata"
          poster={poster}
          width={width}
          height={height}
          data-video-evidence-player
        >
          {
            webm && (
              <source
                src={webm}
                type="video/webm"
              />
            )
          }
          <source src={mp4} type="video/mp4" />
        </video>
        <p class="home-lightbox__caption">
          {caption}
        </p>
      </div>
    </div>
  </dialog>

  <figcaption class="home-evidence__caption">
    {caption}
  </figcaption>
</figure>

<script>
  const evidences =
    document.querySelectorAll<HTMLElement>(
      "[data-video-evidence]",
    );

  for (const evidence of evidences) {
    const trigger =
      evidence.querySelector<HTMLButtonElement>(
        "[data-video-evidence-open]",
      );
    const dialog =
      evidence.querySelector<HTMLDialogElement>(
        "[data-video-evidence-dialog]",
      );
    const preview =
      evidence.querySelector<HTMLVideoElement>(
        "[data-video-evidence-inline]",
      );
    const player =
      evidence.querySelector<HTMLVideoElement>(
        "[data-video-evidence-player]",
      );
    const close =
      evidence.querySelector<HTMLButtonElement>(
        "[data-video-evidence-close]",
      );

    const timecode =
      evidence.querySelector<HTMLElement>(
        "[data-video-evidence-timecode]",
      );

    if (
      !trigger ||
      !dialog ||
      !preview ||
      !player ||
      !timecode
    )
      continue;

    const stamp = (seconds: number) => {
      const whole = Math.floor(seconds);
      const m = Math.floor(whole / 60);
      const s = String(whole % 60).padStart(2, "0");
      return `${m}:${s}`;
    };

    // Driven by `timeupdate` rather than a rAF loop:
    // the text only changes once a second, and the
    // event goes quiet on its own whenever the video
    // pauses — including the browser parking it while
    // it is off screen. The DOM write is skipped until
    // the displayed second actually changes.
    let shown = "";
    const renderTime = () => {
      const next = stamp(preview.currentTime);
      if (next !== shown) {
        shown = next;
        timecode.textContent = next;
      }
    };
    preview.addEventListener(
      "timeupdate",
      renderTime,
    );
    renderTime();

    // An unmuted start is not allowed everywhere. If
    // the browser refuses, fall back to the terms the
    // preview already plays on rather than opening on
    // a still frame.
    const play = () => {
      void player.play().catch(() => {
        player.muted = true;
        void player.play().catch(() => {});
      });
    };

    // Undoing the scroll lock is what strands a page if
    // it is missed, so it runs from every way out — the
    // two we handle here and `close`, which is all an
    // Escape key leaves us. Running twice is harmless.
    const collapse = () => {
      delete document.body.dataset.lightboxOpen;
      player.pause();
      void preview.play().catch(() => {});
    };

    const dismiss = () => {
      dialog.close();
      collapse();
      trigger.focus();
    };

    trigger.addEventListener("click", () => {
      // Pick up where the muted preview loop is, so
      // expanding keeps the frame you clicked on.
      player.currentTime = preview.currentTime;
      preview.pause();
      document.body.dataset.lightboxOpen = "true";
      dialog.showModal();
      play();
    });

    close?.addEventListener("click", dismiss);

    // Everything but the player itself — backdrop,
    // gutters, caption — is a way back to the page.
    dialog.addEventListener("click", (event) => {
      const target =
        event.target as HTMLElement | null;
      if (
        !target?.closest(
          "[data-video-evidence-player]",
        )
      ) {
        dismiss();
      }
    });

    dialog.addEventListener("close", collapse);
  }
</script>
