---
import { markdownPathForSlug } from "../lib/agent-docs";

const { id } = Astro.locals.starlightRoute;
const markdownHref =
  id.startsWith("docs/") || id.startsWith("grid/")
    ? markdownPathForSlug(id)
    : undefined;
---

{
  markdownHref && (
    <a
      class="agent-page-action print:hidden"
      href={markdownHref}
    >
      View as Markdown
    </a>
  )
}

<style>
  @layer starlight.components {
    .agent-page-action {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      min-height: 2rem;
      padding: 0.35rem 0.65rem;
      border: 1px solid
        var(--sl-color-hairline-light);
      border-radius: 0.375rem;
      color: var(--sl-color-text-accent);
      font-size: var(--sl-text-sm);
      font-weight: 600;
      line-height: 1.2;
      text-decoration: none;
    }

    .agent-page-action:hover {
      border-color: var(--sl-color-accent);
      color: var(--sl-color-white);
    }
  }
</style>
