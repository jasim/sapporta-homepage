---
import DefaultHead from "@astrojs/starlight/components/Head.astro";
import { markdownPathForSlug } from "../lib/agent-docs";

const { id } = Astro.locals.starlightRoute;
const markdownHref =
  id.startsWith("docs/") || id.startsWith("grid/")
    ? markdownPathForSlug(id)
    : undefined;
---

<link
  rel="preconnect"
  href="https://fonts.googleapis.com"
/>
<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin
/>
<link
  href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap"
  rel="stylesheet"
/>
<DefaultHead />
{
  markdownHref && (
    <link
      rel="alternate"
      type="text/markdown"
      href={markdownHref}
    />
  )
}
