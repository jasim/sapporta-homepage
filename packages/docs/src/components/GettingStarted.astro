---
import { Copy } from "lucide-react";
import { gettingStartedEnv } from "../lib/getting-started-env.mjs";

const createProjectAgentUrl =
  gettingStartedEnv.agentMarkdownUrl(
    "docs/getting-started/create-a-project",
  );
const createProjectAgentPreamble = `Before you begin, ensure the Sapporta skill is installed:
npx skills add https://github.com/jasim/sapporta-skills --skill sapporta --global --yes

Load and follow the Sapporta skill. It owns project setup, modelling, implementation, and verification.`;

const applicationPrompts = [
  {
    label: "Calorie tracker",
    request:
      "Build a personal calorie tracker with Sapporta.",
    body: `Model foods, meals, meal items, and date-ranged nutrition goals.

Include:
- a user-maintained food list with serving sizes, calories, protein, carbs, fat, and fiber
- one workflow to log a meal with multiple food items
- server-validated serving units and stored nutrition snapshots that preserve history
- today and Monday-Sunday weekly summaries against independent daily and weekly goals

Add realistic sample data.`,
  },
  {
    label: "Book-keeping",
    request:
      "Build a personal double-entry book-keeping app with Sapporta.",
    body: `Model accounts, transactions, journal entries, categories, payees, and budgets.

Include:
- easy entry for income, expenses, and transfers, with automatic double-entry mapping to balanced debits and credits underneath
- an auditable double-entry ledger
- monthly budgets and category rules
- reports for balances, cash flow, and spending by category

Add realistic sample data.`,
  },
  {
    label: "Task management",
    request:
      "Build a task management app with Sapporta.",
    body: `Model people, projects, tasks, labels, and comments.

Include:
- task creation and assignment
- status, priority, due dates, labels, and comments
- views for open tasks, overdue tasks, assignees, and projects

Add realistic sample data.`,
  },
  {
    label: "CRM",
    request: "Build a CRM with Sapporta.",
    body: `Model companies, contacts, opportunities, activities, and follow-ups.

Include:
- lead and opportunity tracking
- contact history, notes, and next steps
- owners, stages, expected values, and close dates
- views for the pipeline, overdue follow-ups, companies, and owners

Add realistic sample data.`,
  },
].map((application) => ({
  ...application,
  prompt: `${createProjectAgentPreamble}\n\n${application.request}\n${createProjectAgentUrl}\n\n${application.body}`,
}));

const defaultApplication =
  applicationPrompts.find(
    ({ label }) => label === "Task management",
  ) ?? applicationPrompts[0];
---

<div class="home-layout home-layout--quick-start">
  <section
    class="home-quick-start"
    aria-labelledby="get-started"
  >
    <div class="home-quick-start__content">
      <h2
        class="home-quick-start__title"
        id="get-started"
      >
        Get started with your coding agent
      </h2>
      <p class="home-quick-start__description">
        Copy this starter prompt, then paste it
        into your coding agent.
      </p>
      <div
        class="home-quick-start__applications"
        role="group"
        aria-label="Choose an application prompt"
      >
        {
          applicationPrompts.map(
            (application) => {
              const isSelected =
                application ===
                defaultApplication;

              return (
                <button
                  class="home-quick-start__application-button"
                  type="button"
                  data-agent-prompt-option
                  data-agent-prompt-value={
                    application.prompt
                  }
                  data-agent-prompt-label={
                    application.label
                  }
                  data-selected={
                    isSelected
                      ? "true"
                      : undefined
                  }
                  aria-pressed={
                    isSelected ? "true" : "false"
                  }
                >
                  {application.label}
                </button>
              );
            },
          )
        }
      </div>
      <button
        class="home-quick-start__copy-button"
        type="button"
        data-copy-agent-prompt
        aria-label="Copy starter prompt to clipboard"
        title="Copy starter prompt to clipboard"
      >
        <Copy
          aria-hidden="true"
          size={17}
          strokeWidth={2.25}
        />
        <span data-copy-agent-label>
          Copy starter prompt
        </span>
      </button>
      <span
        class="home-quick-start__status"
        data-copy-agent-status
        aria-live="polite"></span>
      <pre
        class="home-quick-start__prompt"
        data-agent-prompt>{defaultApplication.prompt}</pre>
    </div>
  </section>
</div>

<script>
  const copyAgentPromptButton =
    document.querySelector<HTMLButtonElement>(
      "[data-copy-agent-prompt]",
    );
  const agentPrompt =
    document.querySelector<HTMLElement>(
      "[data-agent-prompt]",
    );
  const copyAgentStatus =
    document.querySelector<HTMLElement>(
      "[data-copy-agent-status]",
    );
  const copyAgentLabel =
    document.querySelector<HTMLElement>(
      "[data-copy-agent-label]",
    );
  const agentPromptOptions =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-agent-prompt-option]",
    );
  let copyAgentStatusTimeout:
    ReturnType<typeof setTimeout> | undefined;

  const resetCopyAgentFeedback = () => {
    if (!copyAgentPromptButton) return;

    delete copyAgentPromptButton.dataset.copied;
    copyAgentPromptButton.title =
      "Copy starter prompt to clipboard";
    if (copyAgentLabel) {
      copyAgentLabel.textContent =
        "Copy starter prompt";
    }
  };

  agentPromptOptions.forEach((option) => {
    option.addEventListener("click", () => {
      const prompt =
        option.dataset.agentPromptValue;
      if (!agentPrompt || !prompt) return;

      agentPrompt.textContent = prompt;
      agentPromptOptions.forEach((candidate) => {
        const isSelected = candidate === option;
        candidate.setAttribute(
          "aria-pressed",
          String(isSelected),
        );
        if (isSelected) {
          candidate.dataset.selected = "true";
        } else {
          delete candidate.dataset.selected;
        }
      });

      clearTimeout(copyAgentStatusTimeout);
      resetCopyAgentFeedback();
      if (copyAgentStatus) {
        copyAgentStatus.textContent = `${option.dataset.agentPromptLabel} prompt selected`;
      }
    });
  });

  copyAgentPromptButton?.addEventListener(
    "click",
    async () => {
      const prompt = agentPrompt?.textContent;
      if (!prompt) return;

      try {
        await navigator.clipboard.writeText(
          prompt,
        );
        copyAgentPromptButton.dataset.copied =
          "true";
        copyAgentPromptButton.title = "Copied";
        if (copyAgentLabel) {
          copyAgentLabel.textContent =
            "Copied — paste it into your agent";
        }
        if (copyAgentStatus) {
          copyAgentStatus.textContent =
            "Prompt copied to clipboard";
        }

        clearTimeout(copyAgentStatusTimeout);
        copyAgentStatusTimeout = setTimeout(
          () => {
            resetCopyAgentFeedback();
            if (copyAgentStatus) {
              copyAgentStatus.textContent = "";
            }
          },
          2000,
        );
      } catch {
        if (copyAgentLabel) {
          copyAgentLabel.textContent =
            "Copy failed";
        }
        if (copyAgentStatus) {
          copyAgentStatus.textContent =
            "Could not copy prompt";
        }
      }
    },
  );
</script>
