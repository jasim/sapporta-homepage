---
import {
  Check,
  Copy,
  Hammer,
} from "lucide-react";
import { gettingStartedEnv } from "../lib/getting-started-env.mjs";

const createProjectAgentUrl =
  gettingStartedEnv.agentMarkdownUrl(
    "docs/getting-started/create-a-project",
  );
const skillInstallCommand =
  "npx skills add https://github.com/jasim/sapporta-skills --skill sapporta --global --yes";
const createProjectAgentPreamble = `Before you begin, ensure the Sapporta skill is installed:
${skillInstallCommand}

Load and follow the Sapporta skill. It owns project setup, modelling, implementation, and verification.`;

const applicationPrompts = [
  {
    label: "Calorie tracker",
    application: "a personal calorie tracker",
    model:
      "foods, meals, meal items, and date-ranged nutrition goals",
    include: [
      "a user-maintained food list where each food defines one serving — a quantity plus a measurable unit (g, kg, ml, l, piece, tbsp, tsp) — and calories, protein, carbs, fat, and fiber per serving",
      "one transactional workflow to log a meal (time, optional category label) with many items, each picking a food and a quantity in that food's own serving unit — no unit conversion; mismatched units are rejected server-side",
      "each meal item stores a snapshot of the food's details and its computed nutrition (quantity ÷ serving quantity × per-serving values), so editing a food never changes logged history or past reports",
      "non-overlapping date-ranged goals, optionally open-ended, holding independent daily and weekly targets for every nutrient",
      "a dashboard for today and the Monday-Sunday week: consumed, target, remaining, and percent progress per nutrient, plus the day's logged meals and items",
    ],
  },
  {
    label: "Bookkeeping",
    application:
      "a personal double-entry bookkeeping app",
    model:
      "accounts, transactions, postings, payees, and budgets",
    include: [
      "one chart of accounts spanning asset, liability, equity, income, and expense accounts — income and expense accounts serve as the categories, with no separate category table",
      "easy entry for income, expenses, and transfers: each transaction is a thin header (date, payee, memo) over two or more balanced postings, each posting debiting or crediting exactly one account, so one purchase can split across expense accounts",
      "a general journal entry form for transactions that fit none of those shapes — the user picks the accounts and debit/credit amounts directly, as long as they balance",
      "payees with a default account to auto-categorize new entries",
      "monthly budgets per expense account, and reports for balances, cash flow, and spending",
      "the leanest schema that supports this — no archiving, soft-delete, or status fields",
    ],
  },
  {
    label: "Task management",
    application:
      "a task tracker for a small team working on shared projects",
    model:
      "projects, tasks, labels, and comments — team members are the workspace's existing users, with no separate people table",
    include: [
      "projects and tasks visible to the whole workspace, so the team works from one shared view rather than per-user lists",
      "tasks with a title, description, one assignee, a fixed todo / in-progress / done status, priority, and optional due date — no subtasks, dependencies, or custom workflows",
      "workspace-wide labels that can tag any task",
      "time-ordered comments on tasks as the team's collaboration trail",
      "views for my open tasks, overdue tasks across all projects, and a per-project board grouped by status",
    ],
  },
  {
    label: "Maintenance tracker",
    application:
      "an equipment maintenance tracker for a small operations team",
    model:
      "assets, vendors, maintenance schedules, and work orders; team members are the workspace's existing users",
    include: [
      "a workspace-shared asset register: name, location, serial number, purchase date and cost, and the vendor who services it",
      "recurring maintenance schedules per asset — what needs doing and an interval in days, with the next due date computed from the most recent completed work order",
      "work orders for all actual work, whether generated from a schedule or logged ad hoc for a breakdown or repair: assignee, priority, due date, open / in-progress / done status, completion date, cost, and notes",
      "vendors with contact details and their service history across assets",
      "views for overdue and upcoming maintenance, open work orders by assignee, and per-asset service history with total spend",
      "keep it simple for now: no parts inventory, meter-based triggers, approval chains etc.",
    ],
  },
].map((application) => ({
  ...application,
  prompt: `${createProjectAgentPreamble}

Using Sapporta, build ${application.application}.
${createProjectAgentUrl}

Model ${application.model}.

Include:
${application.include.map((item) => `- ${item}`).join("\n")}

Add realistic sample data, seeded under a user with email test@example.com and password test123. After the project is created, share these credentials with the user so they can access the demo data.`,
}));

const blankPrompt = `${createProjectAgentPreamble}

Using Sapporta, build a project for me.
${createProjectAgentUrl}

I have not described the project yet. Before doing anything else, ask me one
or two questions to find out what I want to build and how I will use it. From
my answers, infer the domain model — the tables, their relationships, and the
key workflows — and show me that plan in a few short lines for confirmation
before you build.

Then build the complete application.

Add realistic sample data, seeded under a user with email test@example.com and password test123. After the project is created, share these credentials with the user so they can access the demo data.`;
---

<section
  class="home-stage home-stage--quick-start"
  aria-labelledby="get-started"
>
  <div
    class="home-layout home-layout--quick-start"
  >
    <div
      class="home-section-marker home-section-marker--quick-start"
    >
      <span>Get Started</span>
    </div>
    <div class="home-quick-start">
      <div class="home-quick-start__content">
        <h2
          class="home-quick-start__title"
          id="get-started"
        >
          Get started with your coding agent
        </h2>
        <p class="home-quick-start__description">
          Copy the prompt and send it to your
          coding agent.
        </p>
        <div
          class="home-quick-start__applications"
          role="group"
          aria-label="Choose a prompt"
        >
          <button
            class="home-quick-start__application-button home-quick-start__application-button--build"
            type="button"
            data-agent-prompt-option
            data-agent-prompt-value={blankPrompt}
            data-agent-prompt-label="Build your project"
            aria-pressed="true"
            data-selected="true"
          >
            <Hammer
              aria-hidden="true"
              size={15}
              strokeWidth={2.25}
            />
            Build your project
          </button>
          <span
            class="home-quick-start__applications-divider"
            aria-hidden="true"
          >
            or, try an existing prompt
          </span>
          <div
            class="home-quick-start__application-options"
          >
            {
              applicationPrompts.map(
                (application) => {
                  return (
                    <button
                      class="home-quick-start__application-button"
                      type="button"
                      data-agent-prompt-option
                      data-agent-prompt-value={
                        application.prompt
                      }
                      data-agent-prompt-label={
                        application.label
                      }
                      aria-pressed="false"
                    >
                      {application.label}
                    </button>
                  );
                },
              )
            }
          </div>
        </div>
        <div
          class="home-quick-start__prompt-shell"
        >
          <pre
            class="home-quick-start__prompt"
            data-agent-prompt>{blankPrompt}</pre>
          <button
            class="home-quick-start__prompt-copy"
            type="button"
            data-copy-agent-prompt
            aria-label="Copy starter prompt to clipboard"
            title="Copy starter prompt to clipboard"
          >
            <Copy
              aria-hidden="true"
              size={26}
              strokeWidth={2}
              data-copy-icon-copy
            />
            <Check
              aria-hidden="true"
              size={26}
              strokeWidth={2}
              data-copy-icon-check
            />
          </button>
        </div>
        <div class="home-quick-start__actions">
          <button
            class="home-quick-start__copy-button"
            type="button"
            data-copy-agent-prompt
            aria-label="Copy starter prompt to clipboard"
            title="Copy starter prompt to clipboard"
          >
            <Copy
              aria-hidden="true"
              size={17}
              strokeWidth={2.25}
            />
            <span data-copy-agent-label>
              Copy starter prompt
            </span>
          </button>
          <span
            class="home-quick-start__status"
            data-copy-agent-status
            aria-live="polite"></span>
        </div>
        <p
          class="home-quick-start__agent-note"
          data-agent-guidance
        >
          Are you a coding agent? If you want to
          build a project using Sapporta, you must
          first install the Sapporta skill with <code
            >{skillInstallCommand}</code
          > before creating or modifying a project.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const copyAgentPromptButtons =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-copy-agent-prompt]",
    );
  const agentPrompt =
    document.querySelector<HTMLElement>(
      "[data-agent-prompt]",
    );
  const copyAgentStatus =
    document.querySelector<HTMLElement>(
      "[data-copy-agent-status]",
    );
  const copyAgentLabel =
    document.querySelector<HTMLElement>(
      "[data-copy-agent-label]",
    );
  const agentPromptOptions =
    document.querySelectorAll<HTMLButtonElement>(
      "[data-agent-prompt-option]",
    );
  let copyAgentStatusTimeout:
    ReturnType<typeof setTimeout> | undefined;

  const resetCopyAgentFeedback = () => {
    copyAgentPromptButtons.forEach((button) => {
      delete button.dataset.copied;
      button.title =
        "Copy starter prompt to clipboard";
    });
    if (copyAgentLabel) {
      copyAgentLabel.textContent =
        "Copy starter prompt";
    }
  };

  const selectAgentPromptOption = (
    selectedOption: HTMLButtonElement,
  ) => {
    agentPromptOptions.forEach((option) => {
      const isSelected =
        option === selectedOption;
      option.setAttribute(
        "aria-pressed",
        String(isSelected),
      );
      if (isSelected) {
        option.dataset.selected = "true";
      } else {
        delete option.dataset.selected;
      }
    });
  };

  agentPromptOptions.forEach((option) => {
    option.addEventListener("click", () => {
      const prompt =
        option.dataset.agentPromptValue;
      if (!agentPrompt || !prompt) return;

      agentPrompt.textContent = prompt;
      selectAgentPromptOption(option);

      clearTimeout(copyAgentStatusTimeout);
      resetCopyAgentFeedback();
      if (copyAgentStatus) {
        copyAgentStatus.textContent = `${option.dataset.agentPromptLabel} prompt selected`;
      }
    });
  });

  copyAgentPromptButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const prompt = agentPrompt?.textContent;
      if (!prompt) return;

      try {
        await navigator.clipboard.writeText(
          prompt,
        );
        copyAgentPromptButtons.forEach(
          (copyButton) => {
            copyButton.dataset.copied = "true";
            copyButton.title = "Copied";
          },
        );
        if (copyAgentLabel) {
          copyAgentLabel.textContent =
            "Copied — paste it into your agent";
        }
        if (copyAgentStatus) {
          copyAgentStatus.textContent =
            "Prompt copied to clipboard";
        }

        clearTimeout(copyAgentStatusTimeout);
        copyAgentStatusTimeout = setTimeout(
          () => {
            resetCopyAgentFeedback();
            if (copyAgentStatus) {
              copyAgentStatus.textContent = "";
            }
          },
          2000,
        );
      } catch {
        if (copyAgentLabel) {
          copyAgentLabel.textContent =
            "Copy failed";
        }
        if (copyAgentStatus) {
          copyAgentStatus.textContent =
            "Could not copy prompt";
        }
      }
    });
  });
</script>
