---
import { Code } from "astro:components";
import { Code2, Table2 } from "lucide-react";
import BooksTableDataGrid from "./BooksTableDataGrid";
import { codeThemes } from "../lib/code-themes.mjs";
const booksSchemaCode = `export const booksTable = sqliteTable("books", {
  id: integer("id").primaryKey({ autoIncrement: true }),
  title: text("title").notNull(),
  author: text("author").notNull(),
});

export const books = sapportaTable({
  drizzle: booksTable,
  meta: {
    label: "Books",
    rowScope: "systemGlobal",
    rowLabelColumns: ["title"],
    search: { columns: ["author", "title"] },
    children: [
      {
        table: "quotes",
        foreignKey: "book_id",
        label: "Quotes",
        columns: ["quote_text"],
        defaultSort: "-created_at",
      },
    ],
    columns: {
      title: { width: 64 },
      author: { width: 36 },
    },
  },
});`;
---

<section
  class="home-demo-section"
  aria-labelledby="home-demo-title"
>
  <div class="home-demo" data-demo-tabs>
    <div class="home-demo__heading">
      <p
        class="home-demo__label"
        id="home-demo-title"
      >
        Demo
      </p>
      <p class="home-demo__hint">
        Arrow keys for navigation. <kbd
          class="home-demo__key">Space</kbd
        > to expand quotes.
      </p>
    </div>
    <div
      class="home-demo__tabs"
      role="tablist"
      aria-label="Data grid example views"
    >
      <button
        class="home-demo__tab"
        id="home-demo-grid-tab"
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls="home-demo-grid-panel"
      >
        <Table2
          className="home-demo__tab-icon"
          aria-hidden="true"
          size={17}
          strokeWidth={2}
        />
        <span>Sample data grid</span>
      </button>
      <button
        class="home-demo__tab"
        id="home-demo-code-tab"
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="home-demo-code-panel"
        tabindex="-1"
      >
        <Code2
          className="home-demo__tab-icon"
          aria-hidden="true"
          size={17}
          strokeWidth={2}
        />
        <span>Code: schema definition</span>
      </button>
    </div>

    <div
      class="home-demo__panel home-demo__panel--grid"
      id="home-demo-grid-panel"
      role="tabpanel"
      aria-labelledby="home-demo-grid-tab"
    >
      <BooksTableDataGrid client:only="react" />
    </div>

    <div
      class="home-demo__panel home-demo__panel--code"
      id="home-demo-code-panel"
      role="tabpanel"
      aria-labelledby="home-demo-code-tab"
      hidden
    >
      <figure class="home-code-sample">
        <figcaption
          class="home-code-sample__header"
        >
          <span class="home-code-sample__path">
            packages/api/schema/books.ts
          </span>
        </figcaption>
        <div class="home-code-sample__body">
          <Code
            code={booksSchemaCode}
            lang="ts"
            themes={codeThemes}
          />
        </div>
      </figure>
    </div>
  </div>
</section>

<script>
  const demos =
    document.querySelectorAll<HTMLElement>(
      "[data-demo-tabs]",
    );

  for (const demo of demos) {
    const tabs = Array.from(
      demo.querySelectorAll<HTMLButtonElement>(
        '[role="tab"]',
      ),
    );
    const panels = Array.from(
      demo.querySelectorAll<HTMLElement>(
        '[role="tabpanel"]',
      ),
    );

    const selectTab = (
      selectedTab: HTMLButtonElement,
      moveFocus = false,
    ) => {
      for (const tab of tabs) {
        const isSelected = tab === selectedTab;
        tab.setAttribute(
          "aria-selected",
          String(isSelected),
        );
        tab.tabIndex = isSelected ? 0 : -1;
      }

      for (const panel of panels) {
        panel.hidden =
          panel.id !==
          selectedTab.getAttribute(
            "aria-controls",
          );
      }

      if (moveFocus) selectedTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        selectTab(tab);
      });

      tab.addEventListener("keydown", (event) => {
        let nextIndex: number | undefined;

        if (event.key === "ArrowRight") {
          nextIndex = (index + 1) % tabs.length;
        } else if (event.key === "ArrowLeft") {
          nextIndex =
            (index - 1 + tabs.length) %
            tabs.length;
        } else if (event.key === "Home") {
          nextIndex = 0;
        } else if (event.key === "End") {
          nextIndex = tabs.length - 1;
        }

        if (nextIndex === undefined) return;
        event.preventDefault();
        selectTab(tabs[nextIndex], true);
      });
    });
  }
</script>
