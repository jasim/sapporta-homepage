---
import { Code } from "astro:components";
import SapportaMark from "../../components/SapportaMark.astro";
import "../../styles/sapporta.css";
import "../../styles/home3.css";

const title = "Sapporta Grid";
const description =
  "Editable, hierarchical data grids for React, backed by a composable JavaScript runtime.";
const codeTheme = "github-light-default";

const openingCode = `const schema = gridSchema({
  rootLevel: "projects",
  levels: {
    projects: level({
      columns: [text("project"), select("status"), date("due")],
      children: { tasks: ({ row }) => taskSource(row.id) },
    }),
    tasks: level({
      columns: [text("task", { edit: true }), select("state"), text("assignee")],
    }),
  },
});

const runtime = createGridRuntime({
  schema,
  dataSource: projectSource,
});

<GridRuntimeProvider runtime={runtime}>
  <GridLevel path={runtime.root.path} />
</GridRuntimeProvider>`;

const adapterCode = `const projectSource = remoteGridDataSource({
  async load({ sort, filters }) {
    const response = await api.projects.list({ sort, filters });
    return response.items.map(toGridRow);
  },
  async write({ rowId, columnId, value }) {
    return api.projects.update(rowId, { [columnId]: value });
  },
});`;

const runtimeCode = `const runtime = createGridRuntime({ schema, dataSource });
const orderId = makeRowId(runtime.root.path, "O1");

await runtime.root.data.query?.sort?.set([
  { colId: "amount", direction: "asc" },
]);
runtime.root.toggleExpand(orderId);
runtime.root.writeCell({ rowId: orderId, colId: "amount" }, 125);`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={description}
    />
    <link
      rel="canonical"
      href="https://sapporta.com/grid/"
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <title>{title}</title>
  </head>
  <body class="homepage grid-document">
    <header class="grid-masthead">
      <a class="grid-wordmark" href="/">
        <SapportaMark
          class="grid-wordmark-mark"
          title=""
        />
        <span>Sapporta</span>
      </a>
      <nav aria-label="Main navigation">
        <a
          href="/grid/start/install-and-render-the-first-grid/"
          >Documentation</a
        >
        <a
          href="https://github.com/jasim/sapporta/tree/main/packages/grid"
          >Source</a
        >
        <a href="/">Sapporta framework</a>
      </nav>
    </header>

    <main>
      <article class="grid-article">
        <header class="grid-opening">
          <p class="grid-overline">
            React grid framework
          </p>
          <h1>Sapporta Grid</h1>
          <p class="grid-standfirst">
            Editable, hierarchical data is
            rendered in React by Sapporta Grid.
            Levels, columns, editing rules, and
            interactions are defined in a schema.
            Grid operations are handled beneath
            the rendered surface by a JavaScript
            runtime.
          </p>
          <p>
            Schema and data-source state are
            rendered directly by the default
            components. Individual renderers and
            editors can be replaced by the
            application. The same grid operations
            are available to tests, scripts, and
            other view layers through the runtime,
            without rendering the React
            components.
          </p>
          <p class="grid-reading-links">
            <a
              href="/grid/start/install-and-render-the-first-grid/"
              >Install and render the first grid</a
            >
            <span aria-hidden="true">·</span>
            <a
              href="https://github.com/jasim/sapporta/tree/main/packages/grid"
              >Read the source</a
            >
          </p>
        </header>

        <figure
          class="grid-figure grid-code-figure"
        >
          <figcaption>
            <span>01</span>
            <strong
              >A schema with project and task
              levels</strong
            >
            <code>ProjectGrid.tsx</code>
          </figcaption>
          <div class="grid-code">
            <Code
              code={openingCode}
              lang="tsx"
              theme={codeTheme}
            />
          </div>
        </figure>

        <figure
          class="grid-figure grid-live-figure"
          data-grid-demo
        >
          <figcaption>
            <span>02</span>
            <strong
              >The rendered project grid</strong
            >
            <span>Local demo data</span>
          </figcaption>

          <div class="grid-demo-instructions">
            <p>
              Project expansion, task editing,
              sorting, and draft creation are
              available in the example below. Each
              operation is connected to the
              controls.
            </p>
            <div class="grid-demo-controls">
              <label>
                <span>Filter projects</span>
                <input
                  type="search"
                  placeholder="Type a project name"
                  data-grid-filter
                />
              </label>
              <button type="button" data-grid-add
                >Add a project</button
              >
            </div>
            <output data-grid-url
              >/grid?sort=project:asc</output
            >
          </div>

          <div class="grid-demo-scroll">
            <div
              class="grid-demo"
              role="grid"
              aria-label="Editable projects and tasks"
            >
              <div
                class="grid-demo-row grid-demo-header"
                role="row"
              >
                <span role="columnheader"></span>
                <button
                  type="button"
                  role="columnheader"
                  data-grid-sort="project"
                  aria-sort="ascending"
                >
                  Project <span aria-hidden="true"
                    >↑</span
                  >
                </button>
                <span role="columnheader"
                  >Status</span
                >
                <span role="columnheader"
                  >Owner</span
                >
                <span role="columnheader"
                  >Due</span
                >
              </div>

              <div
                class="grid-project"
                data-project="Ledger import"
              >
                <div
                  class="grid-demo-row"
                  role="row"
                >
                  <button
                    class="grid-expander"
                    type="button"
                    aria-expanded="false"
                    aria-label="Expand Ledger import"
                    data-grid-expand>›</button
                  >
                  <span
                    role="gridcell"
                    tabindex="0"
                    >Ledger import</span
                  >
                  <span role="gridcell"
                    ><span
                      class="grid-state"
                      data-state="doing"
                      >Doing</span
                    ></span
                  >
                  <span role="gridcell">Maya</span
                  >
                  <span role="gridcell"
                    >18 Jul</span
                  >
                </div>
                <div
                  class="grid-child-level"
                  hidden
                >
                  <div class="grid-child-note">
                    Tasks are loaded from the
                    project task source.
                  </div>
                  <div class="grid-child-header">
                    <span>Task</span><span
                      >State</span
                    ><span>Assignee</span>
                  </div>
                  <div class="grid-child-row">
                    <span
                      contenteditable="true"
                      role="textbox"
                      aria-label="Task title"
                      >Validate imported balances</span
                    >
                    <select
                      aria-label="Task state"
                      ><option>To do</option
                      ><option selected
                        >Doing</option
                      ><option>Done</option
                      ></select
                    >
                    <span>Maya</span>
                  </div>
                  <div class="grid-child-row">
                    <span
                      contenteditable="true"
                      role="textbox"
                      aria-label="Task title"
                      >Report rejected rows</span
                    >
                    <select
                      aria-label="Task state"
                      ><option selected
                        >To do</option
                      ><option>Doing</option
                      ><option>Done</option
                      ></select
                    >
                    <span>Arun</span>
                  </div>
                </div>
              </div>

              <div
                class="grid-project"
                data-project="Invoice editor"
              >
                <div
                  class="grid-demo-row"
                  role="row"
                >
                  <button
                    class="grid-expander"
                    type="button"
                    aria-expanded="false"
                    aria-label="Expand Invoice editor"
                    data-grid-expand>›</button
                  >
                  <span
                    role="gridcell"
                    tabindex="0"
                    >Invoice editor</span
                  >
                  <span role="gridcell"
                    ><span
                      class="grid-state"
                      data-state="ready"
                      >Ready</span
                    ></span
                  >
                  <span role="gridcell"
                    >Jasim</span
                  >
                  <span role="gridcell"
                    >22 Jul</span
                  >
                </div>
                <div
                  class="grid-child-level"
                  hidden
                >
                  <div class="grid-child-note">
                    Task columns and a separate
                    data adapter are used at this
                    level.
                  </div>
                  <div class="grid-child-header">
                    <span>Task</span><span
                      >State</span
                    ><span>Assignee</span>
                  </div>
                  <div class="grid-child-row">
                    <span
                      contenteditable="true"
                      role="textbox"
                      aria-label="Task title"
                      >Line item lookup</span
                    >
                    <select
                      aria-label="Task state"
                      ><option>To do</option
                      ><option selected
                        >Doing</option
                      ><option>Done</option
                      ></select
                    >
                    <span>Jasim</span>
                  </div>
                </div>
              </div>

              <div
                class="grid-project"
                data-project="Keyboard navigation"
              >
                <div
                  class="grid-demo-row"
                  role="row"
                >
                  <button
                    class="grid-expander"
                    type="button"
                    aria-expanded="false"
                    aria-label="Expand Keyboard navigation"
                    data-grid-expand>›</button
                  >
                  <span
                    role="gridcell"
                    tabindex="0"
                    >Keyboard navigation</span
                  >
                  <span role="gridcell"
                    ><span
                      class="grid-state"
                      data-state="open">Open</span
                    ></span
                  >
                  <span role="gridcell">Noah</span
                  >
                  <span role="gridcell"
                    >29 Jul</span
                  >
                </div>
                <div
                  class="grid-child-level"
                  hidden
                >
                  <div class="grid-child-note">
                    Tasks remain inside the
                    project that requested them.
                  </div>
                  <div class="grid-child-header">
                    <span>Task</span><span
                      >State</span
                    ><span>Assignee</span>
                  </div>
                  <div class="grid-child-row">
                    <span
                      contenteditable="true"
                      role="textbox"
                      aria-label="Task title"
                      >Range selection</span
                    >
                    <select
                      aria-label="Task state"
                      ><option selected
                        >To do</option
                      ><option>Doing</option
                      ><option>Done</option
                      ></select
                    >
                    <span>Noah</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </figure>

        <section
          class="grid-prose-section"
          aria-labelledby="hierarchy-heading"
        >
          <p class="grid-margin-label">
            Levels and data
          </p>
          <div class="grid-prose">
            <h2 id="hierarchy-heading">
              Hierarchical grids and level data
              sources
            </h2>
            <p>
              Each kind of grid is described by a
              level. Project columns and a project
              endpoint belong to the project
              level. A task level with different
              columns, editing rules, and an
              independent endpoint can be loaded
              by expanding a project. Focus,
              selection, expansion, and editing
              are maintained across the visible
              hierarchy.
            </p>
            <p>
              Local memory or an existing remote
              API can supply data to each level
              through its own data source.
              Loading, ready, refreshing, and
              failure states are published inside
              the requesting level. The project
              grid therefore remains visible when
              a task request fails.
            </p>
          </div>
          <figure
            class="grid-inline-figure grid-code-figure"
          >
            <figcaption>
              <span>Data adapter</span>
              <strong
                >A remote data-source adapter</strong
              >
            </figcaption>
            <div class="grid-code">
              <Code
                code={adapterCode}
                lang="ts"
                theme={codeTheme}
              />
            </div>
          </figure>
        </section>

        <section
          class="grid-prose-section"
          aria-labelledby="editing-heading"
        >
          <p class="grid-margin-label">
            Editing and persistence
          </p>
          <div class="grid-prose">
            <h2 id="editing-heading">
              Cell editing and persistence
            </h2>
            <p>
              Editable cells open in place. A
              value can be applied directly to an
              object by a local source. The same
              commit can be translated into the
              application’s update call by a
              remote source. Confirmed or rejected
              values are returned by that call.
              Saving and failure feedback appears
              in the row while the update is in
              progress.
            </p>
            <p>
              New records begin as draft rows. The
              nonblank condition, validation, and
              commit timing are controlled by the
              application. Entered values remain
              in the row for correction and retry
              if creation fails. This editable
              state is created locally by the <em
                >Add a project</em
              > control in the example.
            </p>
            <pre
              class="grid-command"><code>level.drafts.add("new-task", &#123; title: "" &#125;);
level.drafts.setCell("new-task", "title", "Review import");
await level.drafts.commit("new-task");</code></pre>
          </div>
        </section>

        <section
          class="grid-prose-section"
          aria-labelledby="query-heading"
        >
          <p class="grid-margin-label">
            Query state
          </p>
          <div class="grid-prose">
            <h2 id="query-heading">
              Local and remote query state
            </h2>
            <p>
              Sortable columns support ascending
              and descending order. Filters,
              sorting, refetching, and pagination
              can be run in memory or passed
              through a remote adapter. The
              visible grid becomes a linkable
              application view when its query
              state is connected to the browser
              URL. The example URL changes as the
              filter above is edited.
            </p>
          </div>
        </section>

        <section
          class="grid-prose-section"
          aria-labelledby="keyboard-heading"
        >
          <p class="grid-margin-label">
            Keyboard operation
          </p>
          <div class="grid-prose">
            <h2 id="keyboard-heading">
              Keyboard interaction presets
            </h2>
            <p>
              Cell movement and range extension
              are assigned by a spreadsheet-style
              preset. Record movement and Space
              key selection are assigned by
              row-oriented presets. One coherent
              keyboard model is selected for the
              application, without page-local key
              handlers.
            </p>
            <table class="grid-key-table">
              <thead
                ><tr
                  ><th>Key</th><th
                    >Visible result in cell-grid
                    mode</th
                  ></tr
                ></thead
              >
              <tbody>
                <tr
                  ><td><kbd>Arrow keys</kbd></td
                  ><td>Move the active cell.</td
                  ></tr
                >
                <tr
                  ><td
                    ><kbd>Shift</kbd> + <kbd
                      >Arrow</kbd
                    ></td
                  ><td
                    >Extend the selected cell
                    range.</td
                  ></tr
                >
                <tr
                  ><td
                    ><kbd>Enter</kbd> or <kbd
                      >F2</kbd
                    ></td
                  ><td
                    >Start editing an editable
                    cell.</td
                  ></tr
                >
                <tr
                  ><td
                    ><kbd>Tab</kbd> / <kbd
                      >Shift</kbd
                    > + <kbd>Tab</kbd></td
                  ><td
                    >Move to the next or previous
                    grid target.</td
                  ></tr
                >
                <tr
                  ><td
                    ><kbd>Ctrl/Cmd</kbd> + <kbd
                      >Home</kbd
                    ></td
                  ><td
                    >Move to the first grid
                    target.</td
                  ></tr
                >
                <tr
                  ><td
                    ><kbd>Page Up</kbd> / <kbd
                      >Page Down</kbd
                    ></td
                  ><td
                    >Move ten rows up or down.</td
                  ></tr
                >
              </tbody>
            </table>
          </div>
        </section>

        <section
          class="grid-prose-section"
          aria-labelledby="runtime-heading"
        >
          <p class="grid-margin-label">
            Runtime and rendering
          </p>
          <div class="grid-prose">
            <h2 id="runtime-heading">
              The JavaScript runtime and React
              renderer
            </h2>
            <p>
              Row loading, level expansion,
              sorting, filtering, editing,
              creation, selection, and row
              operations are exposed by a core
              JavaScript object. Its state is
              rendered by the supplied React
              primitives. The same public API can
              be operated directly by an
              integration test or a script.
            </p>
            <p>
              Column presets and a default
              stylesheet are included with
              Sapporta Grid. The public DOM and
              state attributes can be styled with
              application CSS. Custom cells and
              editors can also be supplied while
              focus, selection, copy, and editing
              behavior remain under runtime
              control.
            </p>
          </div>
          <figure
            class="grid-inline-figure grid-code-figure"
          >
            <figcaption>
              <span>Runtime test</span>
              <strong
                >A runtime operation without React</strong
              >
            </figcaption>
            <div class="grid-code">
              <Code
                code={runtimeCode}
                lang="ts"
                theme={codeTheme}
              />
            </div>
          </figure>
        </section>

        <footer class="grid-ending">
          <p class="grid-margin-label">
            Where to begin
          </p>
          <div>
            <h2>
              Choosing a grid integration layer
            </h2>
            <p>
              The schema, runtime, React surface,
              and data-source contract are
              available from <code
                >@sapporta/grid</code
              >. Common renderers and editors are
              added by the column-preset entry
              point. Sapporta table metadata,
              generated endpoints, lookups,
              routes, and row access are connected
              to the grid by <code>TGrid</code> in
              <code>@sapporta/frontend</code>.
            </p>
            <p class="grid-ending-links">
              <a
                href="/grid/start/choose-a-grid-layer/"
                >Choose a grid layer →</a
              >
              <a
                href="/docs/getting-started/introduction/"
                >Read about the full Sapporta
                framework →</a
              >
            </p>
          </div>
        </footer>
      </article>
    </main>

    <script>
      const demo = document.querySelector(
        "[data-grid-demo]",
      );
      if (demo instanceof HTMLElement) {
        const list =
          demo.querySelector(".grid-demo");
        const filter = demo.querySelector(
          "[data-grid-filter]",
        );
        const url = demo.querySelector(
          "[data-grid-url]",
        );
        let ascending = true;

        demo
          .querySelectorAll("[data-grid-expand]")
          .forEach((button) => {
            button.addEventListener(
              "click",
              () => {
                const project = button.closest(
                  ".grid-project",
                );
                const child =
                  project?.querySelector(
                    ".grid-child-level",
                  );
                if (
                  !(
                    button instanceof
                    HTMLButtonElement
                  ) ||
                  !(child instanceof HTMLElement)
                )
                  return;
                const open =
                  button.getAttribute(
                    "aria-expanded",
                  ) === "true";
                button.setAttribute(
                  "aria-expanded",
                  String(!open),
                );
                button.textContent = open
                  ? "›"
                  : "⌄";
                child.hidden = open;
              },
            );
          });

        demo
          .querySelector("[data-grid-sort]")
          ?.addEventListener("click", (event) => {
            if (
              !(list instanceof HTMLElement) ||
              !(
                event.currentTarget instanceof
                HTMLButtonElement
              )
            )
              return;
            ascending = !ascending;
            const projects = [
              ...list.querySelectorAll(
                ".grid-project",
              ),
            ];
            projects.sort((a, b) => {
              const left =
                a.getAttribute("data-project") ??
                "";
              const right =
                b.getAttribute("data-project") ??
                "";
              return (
                left.localeCompare(right) *
                (ascending ? 1 : -1)
              );
            });
            projects.forEach((project) =>
              list.append(project),
            );
            event.currentTarget.setAttribute(
              "aria-sort",
              ascending
                ? "ascending"
                : "descending",
            );
            const arrow =
              event.currentTarget.querySelector(
                "span",
              );
            if (arrow)
              arrow.textContent = ascending
                ? "↑"
                : "↓";
            if (url)
              url.textContent = `/grid?sort=project:${ascending ? "asc" : "desc"}`;
          });

        filter?.addEventListener("input", () => {
          if (
            !(filter instanceof HTMLInputElement)
          )
            return;
          const query = filter.value
            .trim()
            .toLowerCase();
          demo
            .querySelectorAll(".grid-project")
            .forEach((project) => {
              if (
                project instanceof HTMLElement
              ) {
                project.hidden = !(
                  project.dataset.project ?? ""
                )
                  .toLowerCase()
                  .includes(query);
              }
            });
          if (url)
            url.textContent = `/grid?filter=${encodeURIComponent(filter.value)}&sort=project:${ascending ? "asc" : "desc"}`;
        });

        demo
          .querySelector("[data-grid-add]")
          ?.addEventListener("click", () => {
            if (!(list instanceof HTMLElement))
              return;
            const draft =
              document.createElement("div");
            draft.className =
              "grid-project grid-project-draft";
            draft.dataset.project = "New project";
            draft.innerHTML = `<div class="grid-demo-row" role="row"><span class="grid-draft-mark">+</span><span role="gridcell"><input aria-label="New project name" value="New project" /></span><span role="gridcell"><span class="grid-state" data-state="draft">Draft</span></span><span role="gridcell">Unassigned</span><span role="gridcell">—</span></div>`;
            list.append(draft);
            draft.querySelector("input")?.focus();
          });
      }
    </script>

    <style>
      :global(*) {
        box-sizing: border-box;
      }
      :global(html) {
        scroll-behavior: smooth;
      }
      :global(body.grid-document) {
        background: #fbfbf8;
        color: #18201d;
        font-family: var(--font-sans);
        font-feature-settings:
          "kern" 1,
          "liga" 1,
          "calt" 1;
        margin: 0;
        overflow-x: hidden;
        padding-bottom: 7rem;
        text-rendering: optimizeLegibility;
      }
      .grid-masthead {
        align-items: center;
        border-bottom: 1px solid #d9ddd7;
        display: flex;
        justify-content: space-between;
        margin: 0 auto;
        max-width: 78rem;
        padding: 1.05rem 1.5rem;
      }
      .grid-wordmark {
        align-items: center;
        color: inherit;
        display: inline-flex;
        font-size: 0.78rem;
        font-weight: 780;
        gap: 0.55rem;
        letter-spacing: 0;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
      }
      .grid-wordmark-mark {
        height: 1.35rem;
        width: 1.35rem;
      }
      .grid-masthead nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem 1.4rem;
      }
      .grid-masthead nav a,
      .grid-reading-links a,
      .grid-ending a {
        color: #075d4c;
        text-decoration-color: rgb(
          7 93 76 / 0.35
        );
        text-underline-offset: 0.2em;
      }
      .grid-masthead nav a {
        font-size: 0.92rem;
        font-weight: 650;
        letter-spacing: 0;
        line-height: 1;
        text-decoration: none;
      }
      .grid-article {
        margin: 0 auto;
        max-width: 78rem;
        min-width: 0;
        padding: 0 1.5rem;
      }
      .grid-opening {
        max-width: 48rem;
        padding: clamp(3.5rem, 8vw, 7.5rem) 0
          3.5rem;
      }
      .grid-overline,
      .grid-margin-label {
        color: #66706a;
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.2;
        text-transform: uppercase;
      }
      .grid-opening h1 {
        font-size: clamp(3.4rem, 8vw, 6.7rem);
        font-weight: 820;
        letter-spacing: 0;
        line-height: 1;
        margin: 1rem 0 1.75rem;
      }
      .grid-opening
        > p:not(
          .grid-overline,
          .grid-reading-links
        ) {
        font-size: clamp(1.08rem, 1.3vw, 1.28rem);
