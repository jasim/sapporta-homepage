---
import { Code } from "astro:components";
import {
  Content as HeroContent,
  frontmatter,
} from "../home-content/hero.md";
import { Content as DataGridExperience } from "../home-content/01-data-grid-experience.md";
import { Content as FeaturesInBrief } from "../home-content/02-features-in-brief.md";
import { Content as RegularApplication } from "../home-content/03-regular-application.md";
import { Content as BuiltForAgents } from "../home-content/05-built-for-agents.md";
import { Content as StackDetails } from "../home-content/stack.md";
import BooksTableDataGrid from "../components/BooksTableDataGrid";
import SapportaMark from "../components/SapportaMark.astro";
import { gettingStartedEnv } from "../lib/getting-started-env.mjs";
import {
  Code2,
  Copy,
  Table2,
} from "lucide-react";
import "../styles/sapporta.css";
import "../styles/homepage-essay.css";

const { page, brand, navigation } = frontmatter;
const codeTheme = "github-light-default";
const createProjectAgentUrl =
  gettingStartedEnv.agentMarkdownUrl(
    "docs/getting-started/create-a-project",
  );
const createProjectAgentPrompt = `Build a focused task management app with Sapporta.
${createProjectAgentUrl}

Model people, projects, tasks, labels, and comments.

Include:
- task creation and assignment
- status, priority, due dates, labels, and comments
- views for open tasks, overdue tasks, assignees, and projects

Add realistic sample data. Keep the first version small and focussed.`;
const booksSchemaCode = `export const booksTable = sqliteTable("books", {
  id: integer("id").primaryKey({ autoIncrement: true }),
  title: text("title").notNull(),
  author: text("author").notNull(),
});

export const books = sapportaTable({
  drizzle: booksTable,
  meta: {
    label: "Books",
    rowScope: "systemGlobal",
    rowLabelColumns: ["title"],
    search: { columns: ["author", "title"] },
    children: [
      {
        table: "quotes",
        foreignKey: "book_id",
        label: "Quotes",
        columns: ["quote_text"],
        defaultSort: "-created_at",
      },
    ],
    columns: {
      title: { width: 64 },
      author: { width: 36 },
    },
  },
});`;
---

<!doctype html>
<html lang={page.language}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={page.description}
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <title>{page.title}</title>
  </head>
  <body class="essay-page">
    <a
      class="essay-skip-link"
      href="#main-content">{page.skipLabel}</a
    >

    <main id="main-content" class="essay-main">
      <div class="essay-shell essay-shell--hero">
        <header class="essay-masthead">
          <h1 class="essay-brand-title">
            <a
              class="essay-wordmark"
              href={brand.href}
            >
              <SapportaMark
                class="essay-wordmark-mark"
                title=""
              />
              <span>{brand.label}</span>
            </a>
          </h1>

          <nav
            class="essay-nav"
            aria-label={navigation.label}
          >
            {
              navigation.links.map((link) => (
                <a href={link.href}>
                  {link.label}
                </a>
              ))
            }
          </nav>
        </header>

        <article class="essay-prose essay-hero">
          <HeroContent />

          <section
            class="essay-capabilities"
            aria-label="Sapporta capabilities"
          >
            <ul class="essay-capability-grid">
              <li class="essay-capability">
                <span
                  class="essay-capability-title"
                >
                  Grids
                </span>
                <span
                  class="essay-capability-text"
                >
                  Editable table UI with search,
                  sort, filters, nesting, and
                  keyboard flow.
                </span>
              </li>
              <li class="essay-capability">
                <span
                  class="essay-capability-title"
                >
                  Reports
                </span>
                <span
                  class="essay-capability-text"
                >
                  Summary rows, detail rows, and
                  drill-down links.
                </span>
              </li>
              <li class="essay-capability">
                <span
                  class="essay-capability-title"
                >
                  REST APIs for every table
                </span>
                <span
                  class="essay-capability-text"
                >
                  CRUD, lookup, count, export, and
                  typed custom endpoints.
                </span>
              </li>
              <li class="essay-capability">
                <span
                  class="essay-capability-title"
                >
                  Forms
                </span>
                <span
                  class="essay-capability-text"
                >
                  Validated data entry with
                  reliable keyboard navigation.
                </span>
              </li>
              <li class="essay-capability">
                <span
                  class="essay-capability-title"
                >
                  Security
                </span>
                <span
                  class="essay-capability-text"
                >
                  Workspace and role scoped reads
                  and writes.
                </span>
              </li>
              <li class="essay-capability">
                <span
                  class="essay-capability-title"
                >
                  Deployment
                </span>
                <span
                  class="essay-capability-text"
                >
                  Project wiring from <code
                    >npx sapporta init</code
                  > to production.
                </span>
              </li>
            </ul>
          </section>
        </article>
      </div>

      <div class="essay-shell essay-shell--grid">
        <section
          class="essay-grid"
          aria-label="Books and Quotes grid demo"
        >
          <div class="essay-demo" data-demo-tabs>
            <div
              class="essay-demo-tabs"
              role="tablist"
              aria-label="Data grid example views"
            >
              <button
                class="essay-demo-tab"
                id="essay-demo-grid-tab"
                type="button"
                role="tab"
                aria-selected="true"
                aria-controls="essay-demo-grid-panel"
              >
                <Table2
                  className="essay-demo-tab-icon"
                  aria-hidden="true"
                  size={17}
                  strokeWidth={2}
                />
                <span>Demo: sample data grid</span
                >
              </button>
              <button
                class="essay-demo-tab"
                id="essay-demo-code-tab"
                type="button"
                role="tab"
                aria-selected="false"
                aria-controls="essay-demo-code-panel"
                tabindex="-1"
              >
                <Code2
                  className="essay-demo-tab-icon"
                  aria-hidden="true"
                  size={17}
                  strokeWidth={2}
                />
                <span
                  >Code: schema definition</span
                >
              </button>
            </div>

            <div
              class="essay-demo-panel"
              id="essay-demo-grid-panel"
              role="tabpanel"
              aria-labelledby="essay-demo-grid-tab"
            >
              <BooksTableDataGrid
                client:only="react"
              />
            </div>

            <div
              class="essay-demo-panel essay-demo-code-panel"
              id="essay-demo-code-panel"
              role="tabpanel"
              aria-labelledby="essay-demo-code-tab"
              hidden
            >
              <figure class="essay-schema-panel">
                <figcaption
                  class="essay-schema-header"
                >
                  <span class="essay-schema-path">
                    packages/api/schema/books.ts
                  </span>
                </figcaption>
                <div class="essay-schema-code">
                  <Code
                    code={booksSchemaCode}
                    lang="ts"
                    theme={codeTheme}
                  />
                </div>
              </figure>
            </div>
          </div>
        </section>
      </div>

      <div
        class="essay-shell essay-shell--get-started"
      >
        <section
          class="essay-get-started"
          aria-labelledby="essay-get-started-title"
        >
          <div class="essay-get-started-header">
            <h2
              class="essay-get-started-title"
              id="essay-get-started-title"
            >
              Get started with your coding agent
            </h2>
            <button
              class="essay-get-started-copy"
              type="button"
              data-copy-agent-prompt
              aria-label="Copy prompt to clipboard"
              title="Copy prompt to clipboard"
            >
              <Copy
                aria-hidden="true"
                size={15}
                strokeWidth={2}
              />
              <span data-copy-agent-label
                >Copy</span
              >
            </button>
            <span
              class="essay-get-started-status"
              data-copy-agent-status
              aria-live="polite"></span>
          </div>
          <pre
            class="essay-get-started-prompt"
            data-agent-prompt>{createProjectAgentPrompt}</pre>
        </section>
      </div>

      <div
        class="essay-shell essay-shell--content"
      >
        <article
          class="essay-prose essay-content"
        >
          <section class="essay-section">
            <DataGridExperience />
          </section>
          <section class="essay-section">
            <FeaturesInBrief />
          </section>
          <section class="essay-section">
            <RegularApplication />
          </section>
          <section class="essay-section">
            <BuiltForAgents />
          </section>
          <section class="essay-section">
            <StackDetails />
          </section>
        </article>
      </div>
    </main>

    <footer class="essay-footer">
      <div class="essay-footer-inner">
        <a
          class="essay-footer-wordmark"
          href={brand.href}
        >
          <SapportaMark
            class="essay-footer-mark"
            title=""
          />
          <span>{brand.label}</span>
        </a>

        <div class="essay-footer-meta">
          <p>
            Sapporta is <a
              href="https://github.com/jasim/sapporta"
              >open-source</a
            > and is released under the MIT license.
          </p>
          <p>
            Built and maintained by <a
              href="https://x.com/jasim_ab"
              >Jasim A Basheer</a
            >, <a href="https://protoship.io"
              >Protoship</a
            >.
          </p>
        </div>
      </div>
    </footer>

    <dialog
      class="essay-lightbox"
      data-image-lightbox
      aria-labelledby="essay-lightbox-caption"
    >
      <div class="essay-lightbox-frame">
        <button
          class="essay-lightbox-close"
          type="button"
          data-image-lightbox-close
          aria-label="Close expanded screenshot"
          title="Close"
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
        <figure class="essay-lightbox-figure">
          <img
            class="essay-lightbox-image"
            data-image-lightbox-image
            alt=""
          />
          <figcaption
            class="essay-lightbox-caption"
            id="essay-lightbox-caption"
            data-image-lightbox-caption
          >
          </figcaption>
        </figure>
      </div>
    </dialog>

    <script>
      const copyAgentPromptButton =
        document.querySelector<HTMLButtonElement>(
          "[data-copy-agent-prompt]",
        );
      const agentPrompt =
        document.querySelector<HTMLElement>(
          "[data-agent-prompt]",
        );
      const copyAgentStatus =
        document.querySelector<HTMLElement>(
          "[data-copy-agent-status]",
        );
      const copyAgentLabel =
        document.querySelector<HTMLElement>(
          "[data-copy-agent-label]",
        );
      let copyAgentStatusTimeout:
        ReturnType<typeof setTimeout> | undefined;

      copyAgentPromptButton?.addEventListener(
        "click",
        async () => {
          const prompt = agentPrompt?.textContent;
          if (!prompt) return;

          try {
            await navigator.clipboard.writeText(
              prompt,
            );
            copyAgentPromptButton.dataset.copied =
              "true";
            copyAgentPromptButton.title =
              "Copied";
            if (copyAgentLabel) {
              copyAgentLabel.textContent =
                "Copied";
            }
            if (copyAgentStatus) {
              copyAgentStatus.textContent =
                "Prompt copied to clipboard";
            }

            clearTimeout(copyAgentStatusTimeout);
            copyAgentStatusTimeout = setTimeout(
              () => {
                delete copyAgentPromptButton
                  .dataset.copied;
                copyAgentPromptButton.title =
                  "Copy prompt to clipboard";
                if (copyAgentLabel) {
                  copyAgentLabel.textContent =
                    "Copy";
                }
                if (copyAgentStatus) {
                  copyAgentStatus.textContent =
                    "";
                }
              },
              2000,
            );
          } catch {
            if (copyAgentLabel) {
              copyAgentLabel.textContent =
                "Copy failed";
            }
            if (copyAgentStatus) {
              copyAgentStatus.textContent =
                "Could not copy prompt";
            }
          }
        },
      );

      const demos =
        document.querySelectorAll<HTMLElement>(
          "[data-demo-tabs]",
        );

      for (const demo of demos) {
        const tabs = Array.from(
          demo.querySelectorAll<HTMLButtonElement>(
            '[role="tab"]',
          ),
        );
        const panels = Array.from(
          demo.querySelectorAll<HTMLElement>(
            '[role="tabpanel"]',
          ),
        );

        const selectTab = (
          selectedTab: HTMLButtonElement,
          moveFocus = false,
        ) => {
          for (const tab of tabs) {
            const isSelected =
              tab === selectedTab;
            tab.setAttribute(
              "aria-selected",
              String(isSelected),
            );
            tab.tabIndex = isSelected ? 0 : -1;
          }

          for (const panel of panels) {
            panel.hidden =
              panel.id !==
              selectedTab.getAttribute(
                "aria-controls",
              );
          }

          if (moveFocus) selectedTab.focus();
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener("click", () => {
            selectTab(tab);
          });

          tab.addEventListener(
            "keydown",
            (event) => {
              let nextIndex: number | undefined;

              if (event.key === "ArrowRight") {
                nextIndex =
                  (index + 1) % tabs.length;
              } else if (
                event.key === "ArrowLeft"
              ) {
                nextIndex =
                  (index - 1 + tabs.length) %
                  tabs.length;
              } else if (event.key === "Home") {
                nextIndex = 0;
              } else if (event.key === "End") {
                nextIndex = tabs.length - 1;
              }

              if (nextIndex === undefined) return;
              event.preventDefault();
              selectTab(tabs[nextIndex], true);
            },
          );
        });
      }

      const imageLightbox =
        document.querySelector<HTMLDialogElement>(
          "[data-image-lightbox]",
        );
      const imageLightboxImage =
        imageLightbox?.querySelector<HTMLImageElement>(
          "[data-image-lightbox-image]",
        );
      const imageLightboxCaption =
        imageLightbox?.querySelector<HTMLElement>(
          "[data-image-lightbox-caption]",
        );
      const imageLightboxClose =
        imageLightbox?.querySelector<HTMLButtonElement>(
          "[data-image-lightbox-close]",
        );
      let imageLightboxTrigger:
        HTMLAnchorElement | undefined;

      const closeImageLightbox = () => {
        imageLightbox?.close();
      };

      const openImageLightbox = (
        trigger: HTMLAnchorElement,
      ) => {
        const image =
          trigger.querySelector<HTMLImageElement>(
            "img",
          );
        if (
          !imageLightbox ||
          !imageLightboxImage ||
          !imageLightboxCaption ||
          !image
        ) {
          return;
        }

        const caption =
          trigger
            .closest("figure")
            ?.querySelector("figcaption")
            ?.textContent?.trim() || image.alt;

        imageLightboxTrigger = trigger;
        imageLightboxImage.src = trigger.href;
        imageLightboxImage.alt = image.alt;
        imageLightboxCaption.textContent =
          caption;
        document.body.dataset.lightboxOpen =
          "true";
        imageLightbox.showModal();
      };

      const imageLinks =
        document.querySelectorAll<HTMLAnchorElement>(
          ".grid-shot-button",
        );

      for (const imageLink of imageLinks) {
        imageLink.addEventListener(
          "click",
          (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            event.preventDefault();
            openImageLightbox(imageLink);
          },
        );
      }

      imageLightboxClose?.addEventListener(
        "click",
        closeImageLightbox,
      );

      imageLightbox?.addEventListener(
        "click",
        (event) => {
          if (event.target === imageLightbox) {
            closeImageLightbox();
          }
        },
      );

      imageLightbox?.addEventListener(
        "close",
        () => {
          delete document.body.dataset
            .lightboxOpen;
          imageLightboxImage?.removeAttribute(
            "src",
          );
          imageLightboxTrigger?.focus();
          imageLightboxTrigger = undefined;
        },
      );
    </script>
  </body>
</html>
