---
import {
  Content as HeroContent,
  frontmatter,
} from "../home-content/hero.md";
import { Content as DataGridExperience } from "../home-content/01-data-grid-experience.mdx";
import { Content as RegularApplication } from "../home-content/03-regular-application.mdx";
import { Content as BuiltForAgents } from "../home-content/05-built-for-agents.mdx";
import { Content as StatusAndContributing } from "../home-content/06-status-and-contributing.md";
import { Content as FrequentlyAskedQuestions } from "../home-content/faq.mdx";
import { Content as Reports } from "../home-content/reports.mdx";
import { Content as StackDetails } from "../home-content/stack.md";
import { Content as WhyAFramework } from "../home-content/why-a-framework.mdx";
import GettingStarted from "../components/GettingStarted.astro";
import HomepageActions from "../components/HomepageActions.astro";
import HomepageDemo from "../components/HomepageDemo.astro";
import SapportaMark from "../components/SapportaMark.astro";
import { gettingStartedEnv } from "../lib/getting-started-env.mjs";
import "../styles/sapporta.css";
import "../styles/homepage-essay.css";

const { page, brand, navigation } = frontmatter;
const homepageUrl = `${gettingStartedEnv.docsCanonicalOrigin}/`;
const llmsIndexUrl = `${gettingStartedEnv.docsCanonicalOrigin}/llms.txt`;
const socialPreviewUrl = `${homepageUrl}og.png`;
const demoApplications = [
  {
    label: "Bookkeeping",
    description:
      "Double-entry accounts, balanced transactions, budgets, and ledger reports.",
    href: "https://accounting.demo.sapporta.com",
    screenshot:
      "/assets/home/screenshots/bookkeeping.png",
  },
  {
    label: "Calorie tracker",
    description:
      "Foods, logged meals, nutrition goals, and a daily progress dashboard.",
    href: "https://calories.demo.sapporta.com",
    screenshot:
      "/assets/home/screenshots/grid-view.png",
  },
  {
    label: "Depot Maintenance tracker",
    description:
      "Assets, recurring schedules, work orders, and per-asset service history.",
    href: "https://depot.demo.sapporta.com",
    screenshot:
      "/assets/home/screenshots/grid-filtering.png",
  },
];
const homepageStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Sapporta",
  description: page.description,
  url: homepageUrl,
  codeRepository:
    "https://github.com/jasim/sapporta",
  programmingLanguage: "TypeScript",
  license: "https://opensource.org/license/mit/",
  downloadUrl:
    "https://www.npmjs.com/package/sapporta",
};
---

<!doctype html>
<html lang={page.language}>
  <head>
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={page.description}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={page.title}
    />
    <meta
      property="og:description"
      content={page.description}
    />
    <meta
      property="og:url"
      content={homepageUrl}
    />
    <meta
      property="og:image"
      content={socialPreviewUrl}
    />
    <meta
      property="og:image:width"
      content="1200"
    />
    <meta
      property="og:image:height"
      content="630"
    />
    <meta
      property="og:image:alt"
      content="Sapporta — Build full database applications from table declarations"
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={page.title}
    />
    <meta
      name="twitter:description"
      content={page.description}
    />
    <meta
      name="twitter:image"
      content={socialPreviewUrl}
    />
    <meta
      name="twitter:image:alt"
      content="Sapporta — Build full database applications from table declarations"
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <link rel="canonical" href={homepageUrl} />
    <link
      rel="alternate"
      type="text/markdown"
      href={llmsIndexUrl}
      title="Sapporta documentation index"
    />
    <title>{page.title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        homepageStructuredData,
      )}
    />
  </head>
  <body class="home-page">
    <a
      class="home-page__skip-link"
      href="#main-content">{page.skipLabel}</a
    >

    <header class="home-header">
      <nav
        class="home-header__nav"
        aria-label={navigation.label}
      >
        {
          navigation.links.map((link) => (
            <a
              class="home-header__nav-link"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main
      id="main-content"
      class="home-page__main"
    >
      <section
        class="home-stage home-stage--value"
        aria-labelledby="home-value-label"
      >
        <div
          class="home-layout home-layout--intro"
        >
          <article class="home-copy home-intro">
            <div class="home-intro__primary">
              <h1 class="home-hero__title">
                <a
                  class="home-wordmark home-wordmark--hero"
                  href={brand.href}
                >
                  <SapportaMark
                    class="home-wordmark__mark home-wordmark__mark--hero"
                    title=""
                  />
                  <span>{brand.label}</span>
                </a>
              </h1>

              <HeroContent />

              <HomepageActions
                align="start"
                compact
                primaryHref="#get-started"
                primaryLabel="Get Started"
                primaryIcon="get-started"
                secondaryHref="#demo-applications"
                secondaryLabel="Try demo apps"
              />
            </div>
          </article>
        </div>

        <div
          class="home-layout home-layout--hero-demo"
        >
          <HomepageDemo />

          <p class="home-demo-pointer">
            <a
              class="home-demo-pointer__link"
              href="#demo-applications"
              >Try demo apps built with Sapporta<span
                class="home-demo-pointer__arrow"
                aria-hidden="true">↓</span
              ></a
            >
          </p>
        </div>

        <div
          class="home-layout home-layout--article home-layout--value"
        >
          <article
            class="home-copy home-article home-article--value"
          >
            <div class="home-section-marker">
              <span id="home-value-label"
                >Features</span
              >
            </div>

            <section
              class="home-article__section home-article__section--feature"
            >
              <BuiltForAgents />
            </section>
            <section
              class="home-article__section home-article__section--feature"
            >
              <DataGridExperience />
            </section>
            <section
              class="home-article__section home-article__section--feature"
            >
              <Reports />
            </section>
          </article>
        </div>
      </section>

      <section
        class="home-stage home-stage--why"
        aria-labelledby="home-why-label"
      >
        <div
          class="home-layout home-layout--article home-layout--why"
        >
          <article
            class="home-copy home-article home-article--why"
          >
            <div
              class="home-section-marker home-section-marker--why"
            >
              <span id="home-why-label"
                >Why Sapporta</span
              >
            </div>

            <section
              class="home-article__section home-article__section--why"
            >
              <WhyAFramework />
            </section>
          </article>
        </div>
      </section>

      <section
        class="home-stage home-stage--demo-apps"
        id="demo-applications"
        aria-labelledby="home-demo-apps-title"
      >
        <div
          class="home-layout home-layout--demo-apps"
        >
          <div
            class="home-section-marker home-section-marker--demo-apps"
          >
            <span>Demo applications</span>
          </div>

          <nav
            class="home-app-links"
            aria-label="Complete applications built with Sapporta"
          >
            <h2
              class="home-app-links__intro"
              id="home-demo-apps-title"
            >
              Try complete applications built with
              Sapporta
            </h2>
            <p class="home-app-links__note">
              Live demos, seeded with sample data,
              no login required.
            </p>
            <ul class="home-app-links__list">
              {
                demoApplications.map((app) => (
                  <li class="home-app-links__item">
                    <a
                      class="home-app-link"
                      href={app.href}
                    >
                      <span class="home-app-link__media">
                        <img
                          class="home-app-link__screenshot"
                          src={app.screenshot}
                          alt=""
                          loading="lazy"
                          decoding="async"
                        />
                      </span>
                      <span class="home-app-link__body">
                        <span class="home-app-link__label">
                          {app.label}
                        </span>
                        <span class="home-app-link__description">
                          {app.description}
                        </span>
                        <span class="home-app-link__cta">
                          Try the demo
                          <span
                            class="home-app-link__arrow"
                            aria-hidden="true"
                          >
                            →
                          </span>
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </section>

      <GettingStarted />

      <section
        class="home-stage home-stage--framework"
        aria-labelledby="home-framework-label"
      >
        <div
          class="home-layout home-layout--article home-layout--framework"
        >
          <article
            class="home-copy home-article home-article--framework"
          >
            <div
              class="home-section-marker home-section-marker--framework"
            >
              <span id="home-framework-label"
                >Framework</span
              >
            </div>

            <section
              class="home-article__section home-article__section--technical"
            >
              <RegularApplication />
            </section>
            <section
              class="home-article__section home-article__section--technical"
            >
              <StackDetails />
            </section>
          </article>
        </div>
      </section>

      <div
        class="home-layout home-layout--article home-layout--supporting"
      >
        <article
          class="home-copy home-article home-article--supporting"
        >
          <section
            class="home-article__section home-article__section--faq"
          >
            <FrequentlyAskedQuestions />
          </section>
          <section
            class="home-article__section home-article__section--status"
          >
            <StatusAndContributing />
          </section>
        </article>
      </div>
    </main>

    <footer class="home-footer">
      <div class="home-footer__inner">
        <a
          class="home-wordmark home-wordmark--footer"
          href={brand.href}
        >
          <SapportaMark
            class="home-wordmark__mark home-wordmark__mark--footer"
            title=""
          />
          <span>{brand.label}</span>
        </a>

        <div class="home-footer__meta">
          <p class="home-footer__paragraph">
            Sapporta is <a
              class="home-footer__link"
              href="https://github.com/jasim/sapporta"
              >open-source</a
            > and is released under the MIT license.
          </p>
          <p class="home-footer__paragraph">
            Built and maintained by <a
              class="home-footer__link"
              href="https://x.com/jasim_ab"
              >Jasim A Basheer</a
            >, <a
              class="home-footer__link"
              href="https://protoship.io"
              >Protoship</a
            >.
          </p>
        </div>
      </div>
    </footer>

    <dialog
      class="home-lightbox"
      data-image-lightbox
      aria-labelledby="home-lightbox-caption"
    >
      <div class="home-lightbox__frame">
        <button
          class="home-lightbox__close"
          type="button"
          data-image-lightbox-close
          aria-label="Close expanded screenshot"
          title="Close"
        >
          <svg
            class="home-lightbox__close-icon"
            aria-hidden="true"
            viewBox="0 0 24 24"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
        <figure class="home-lightbox__figure">
          <img
            class="home-lightbox__image"
            data-image-lightbox-image
            alt=""
          />
          <figcaption
            class="home-lightbox__caption"
            id="home-lightbox-caption"
            data-image-lightbox-caption
          >
          </figcaption>
        </figure>
      </div>
    </dialog>

    <script>
      const imageLightbox =
        document.querySelector<HTMLDialogElement>(
          "[data-image-lightbox]",
        );
      const imageLightboxImage =
        imageLightbox?.querySelector<HTMLImageElement>(
          "[data-image-lightbox-image]",
        );
      const imageLightboxCaption =
        imageLightbox?.querySelector<HTMLElement>(
          "[data-image-lightbox-caption]",
        );
      const imageLightboxClose =
        imageLightbox?.querySelector<HTMLButtonElement>(
          "[data-image-lightbox-close]",
        );
      let imageLightboxTrigger:
        HTMLAnchorElement | undefined;

      const closeImageLightbox = () => {
        imageLightbox?.close();
      };

      const openImageLightbox = (
        trigger: HTMLAnchorElement,
      ) => {
        const image =
          trigger.querySelector<HTMLImageElement>(
            "img",
          );
        if (
          !imageLightbox ||
          !imageLightboxImage ||
          !imageLightboxCaption ||
          !image
        ) {
          return;
        }

        const caption =
          trigger
            .closest("figure")
            ?.querySelector("figcaption")
            ?.textContent?.trim() || image.alt;

        imageLightboxTrigger = trigger;
        imageLightboxImage.src = trigger.href;
        imageLightboxImage.alt = image.alt;
        imageLightboxCaption.textContent =
          caption;
        document.body.dataset.lightboxOpen =
          "true";
        imageLightbox.showModal();
      };

      const imageLinks =
        document.querySelectorAll<HTMLAnchorElement>(
          ".home-screenshot__link",
        );

      for (const imageLink of imageLinks) {
        imageLink.addEventListener(
          "click",
          (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            event.preventDefault();
            openImageLightbox(imageLink);
          },
        );
      }

      imageLightboxClose?.addEventListener(
        "click",
        closeImageLightbox,
      );

      imageLightbox?.addEventListener(
        "click",
        (event) => {
          if (event.target === imageLightbox) {
            closeImageLightbox();
          }
        },
      );

      imageLightbox?.addEventListener(
        "close",
        () => {
          delete document.body.dataset
            .lightboxOpen;
          imageLightboxImage?.removeAttribute(
            "src",
          );
          imageLightboxTrigger?.focus();
          imageLightboxTrigger = undefined;
        },
      );
    </script>
  </body>
</html>
