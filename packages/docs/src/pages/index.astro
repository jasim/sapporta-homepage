---
import {
  Content as HeroContent,
  frontmatter,
} from "../home-content/hero.md";
import { Content as DataGridExperience } from "../home-content/01-data-grid-experience.mdx";
import { Content as FeaturesInBrief } from "../home-content/02-features-in-brief.md";
import { Content as RegularApplication } from "../home-content/03-regular-application.md";
import { Content as BuiltForAgents } from "../home-content/05-built-for-agents.md";
import { Content as StatusAndContributing } from "../home-content/06-status-and-contributing.md";
import { Content as FrequentlyAskedQuestions } from "../home-content/faq.markdown";
import { Content as Screenshots } from "../home-content/screenshots.md";
import { Content as StackDetails } from "../home-content/stack.md";
import GettingStarted from "../components/GettingStarted.astro";
import HomepageActions from "../components/HomepageActions.astro";
import SapportaMark from "../components/SapportaMark.astro";
import { gettingStartedEnv } from "../lib/getting-started-env.mjs";
import "../styles/sapporta.css";
import "../styles/homepage-essay.css";

const { page, brand, navigation } = frontmatter;
const homepageUrl = `${gettingStartedEnv.docsCanonicalOrigin}/`;
const llmsIndexUrl = `${gettingStartedEnv.docsCanonicalOrigin}/llms.txt`;
const socialPreviewUrl = `${homepageUrl}og.png`;
const homepageStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "Sapporta",
  description: page.description,
  url: homepageUrl,
  codeRepository:
    "https://github.com/jasim/sapporta",
  programmingLanguage: "TypeScript",
  license: "https://opensource.org/license/mit/",
  downloadUrl:
    "https://www.npmjs.com/package/sapporta",
};
---

<!doctype html>
<html lang={page.language}>
  <head>
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={page.description}
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:title"
      content={page.title}
    />
    <meta
      property="og:description"
      content={page.description}
    />
    <meta
      property="og:url"
      content={homepageUrl}
    />
    <meta
      property="og:image"
      content={socialPreviewUrl}
    />
    <meta
      property="og:image:width"
      content="1200"
    />
    <meta
      property="og:image:height"
      content="630"
    />
    <meta
      property="og:image:alt"
      content="Sapporta — Build personal database tools agentically"
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={page.title}
    />
    <meta
      name="twitter:description"
      content={page.description}
    />
    <meta
      name="twitter:image"
      content={socialPreviewUrl}
    />
    <meta
      name="twitter:image:alt"
      content="Sapporta — Build personal database tools agentically"
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <link rel="canonical" href={homepageUrl} />
    <link
      rel="alternate"
      type="text/markdown"
      href={llmsIndexUrl}
      title="Sapporta documentation index"
    />
    <title>{page.title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        homepageStructuredData,
      )}
    />
  </head>
  <body class="home-page">
    <a
      class="home-page__skip-link"
      href="#main-content">{page.skipLabel}</a
    >

    <header class="home-header">
      <nav
        class="home-header__nav"
        aria-label={navigation.label}
      >
        {
          navigation.links.map((link) => (
            <a
              class="home-header__nav-link"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main
      id="main-content"
      class="home-page__main"
    >
      <section
        class="home-stage home-stage--value"
        aria-labelledby="home-value-label"
      >
        <div
          class="home-layout home-layout--intro"
        >
          <article class="home-copy home-intro">
            <div class="home-intro__primary">
              <h1 class="home-hero__title">
                <a
                  class="home-wordmark home-wordmark--hero"
                  href={brand.href}
                >
                  <SapportaMark
                    class="home-wordmark__mark home-wordmark__mark--hero"
                    title=""
                  />
                  <span>{brand.label}</span>
                </a>
              </h1>

              <HeroContent />

              <HomepageActions
                align="start"
                compact
                primaryHref="#get-started"
                primaryLabel="Get Started"
                primaryIcon="get-started"
                primaryStyle={false}
              />
            </div>

            <aside
              class="home-capabilities"
              aria-label="Sapporta capabilities"
            >
              <ul class="home-capabilities__list">
                <li
                  class="home-capabilities__item"
                >
                  <span
                    class="home-capabilities__title"
                  >
                    Grids
                  </span>
                  <span
                    class="home-capabilities__description"
                  >
                    Editable table UI with search,
                    sort, filters, nesting, and
                    keyboard flow.
                  </span>
                </li>
                <li
                  class="home-capabilities__item"
                >
                  <span
                    class="home-capabilities__title"
                  >
                    Reports
                  </span>
                  <span
                    class="home-capabilities__description"
                  >
                    Summary rows, detail rows, and
                    drill-down links.
                  </span>
                </li>
                <li
                  class="home-capabilities__item"
                >
                  <span
                    class="home-capabilities__title"
                  >
                    REST APIs for every table
                  </span>
                  <span
                    class="home-capabilities__description"
                  >
                    CRUD, lookup, count, export,
                    and typed custom endpoints.
                  </span>
                </li>
                <li
                  class="home-capabilities__item"
                >
                  <span
                    class="home-capabilities__title"
                  >
                    Forms
                  </span>
                  <span
                    class="home-capabilities__description"
                  >
                    Validated data entry with
                    reliable keyboard navigation.
                  </span>
                </li>
                <li
                  class="home-capabilities__item"
                >
                  <span
                    class="home-capabilities__title"
                  >
                    Security
                  </span>
                  <span
                    class="home-capabilities__description"
                  >
                    Workspace and role scoped
                    reads and writes.
                  </span>
                </li>
                <li
                  class="home-capabilities__item"
                >
                  <span
                    class="home-capabilities__title"
                  >
                    Deployment
                  </span>
                  <span
                    class="home-capabilities__description"
                  >
                    Project wiring from <code
                      class="home-capabilities__code"
                      >npx sapporta init</code
                    > to production.
                  </span>
                </li>
              </ul>
            </aside>
          </article>
        </div>

        <div
          class="home-layout home-layout--article home-layout--value"
        >
          <article
            class="home-copy home-article home-article--value"
          >
            <div class="home-section-marker">
              <span id="home-value-label"
                >Features</span
              >
            </div>

            <section
              class="home-article__section home-article__section--feature"
            >
              <DataGridExperience />
            </section>
            <section
              class="home-article__section home-article__section--feature"
            >
              <BuiltForAgents />
            </section>
          </article>
        </div>

        <GettingStarted />
      </section>

      <section
        class="home-stage home-stage--framework"
        aria-labelledby="home-framework-label"
      >
        <div
          class="home-layout home-layout--article home-layout--framework"
        >
          <article
            class="home-copy home-article home-article--framework"
          >
            <div
              class="home-section-marker home-section-marker--framework"
            >
              <span id="home-framework-label"
                >Framework</span
              >
            </div>

            <section
              class="home-article__section home-article__section--technical"
            >
              <FeaturesInBrief />
            </section>
            <section
              class="home-article__section home-article__section--technical"
            >
              <RegularApplication />
            </section>
            <section
              class="home-article__section home-article__section--technical"
            >
              <StackDetails />
            </section>
          </article>
        </div>
      </section>

      <div
        class="home-layout home-layout--article home-layout--supporting"
      >
        <article
          class="home-copy home-article home-article--supporting"
        >
          <section
            class="home-article__section home-article__section--faq"
          >
            <FrequentlyAskedQuestions />
          </section>
          <section
            class="home-article__section home-article__section--screenshots"
          >
            <Screenshots />
          </section>
          <section
            class="home-article__section home-article__section--status"
          >
            <StatusAndContributing />
          </section>
        </article>
      </div>
    </main>

    <footer class="home-footer">
      <div class="home-footer__inner">
        <a
          class="home-wordmark home-wordmark--footer"
          href={brand.href}
        >
          <SapportaMark
            class="home-wordmark__mark home-wordmark__mark--footer"
            title=""
          />
          <span>{brand.label}</span>
        </a>

        <div class="home-footer__meta">
          <p class="home-footer__paragraph">
            Sapporta is <a
              class="home-footer__link"
              href="https://github.com/jasim/sapporta"
              >open-source</a
            > and is released under the MIT license.
          </p>
          <p class="home-footer__paragraph">
            Built and maintained by <a
              class="home-footer__link"
              href="https://x.com/jasim_ab"
              >Jasim A Basheer</a
            >, <a
              class="home-footer__link"
              href="https://protoship.io"
              >Protoship</a
            >.
          </p>
        </div>
      </div>
    </footer>

    <dialog
      class="home-lightbox"
      data-image-lightbox
      aria-labelledby="home-lightbox-caption"
    >
      <div class="home-lightbox__frame">
        <button
          class="home-lightbox__close"
          type="button"
          data-image-lightbox-close
          aria-label="Close expanded screenshot"
          title="Close"
        >
          <svg
            class="home-lightbox__close-icon"
            aria-hidden="true"
            viewBox="0 0 24 24"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
        <figure class="home-lightbox__figure">
          <img
            class="home-lightbox__image"
            data-image-lightbox-image
            alt=""
          />
          <figcaption
            class="home-lightbox__caption"
            id="home-lightbox-caption"
            data-image-lightbox-caption
          >
          </figcaption>
        </figure>
      </div>
    </dialog>

    <script>
      const imageLightbox =
        document.querySelector<HTMLDialogElement>(
          "[data-image-lightbox]",
        );
      const imageLightboxImage =
        imageLightbox?.querySelector<HTMLImageElement>(
          "[data-image-lightbox-image]",
        );
      const imageLightboxCaption =
        imageLightbox?.querySelector<HTMLElement>(
          "[data-image-lightbox-caption]",
        );
      const imageLightboxClose =
        imageLightbox?.querySelector<HTMLButtonElement>(
          "[data-image-lightbox-close]",
        );
      let imageLightboxTrigger:
        HTMLAnchorElement | undefined;

      const closeImageLightbox = () => {
        imageLightbox?.close();
      };

      const openImageLightbox = (
        trigger: HTMLAnchorElement,
      ) => {
        const image =
          trigger.querySelector<HTMLImageElement>(
            "img",
          );
        if (
          !imageLightbox ||
          !imageLightboxImage ||
          !imageLightboxCaption ||
          !image
        ) {
          return;
        }

        const caption =
          trigger
            .closest("figure")
            ?.querySelector("figcaption")
            ?.textContent?.trim() || image.alt;

        imageLightboxTrigger = trigger;
        imageLightboxImage.src = trigger.href;
        imageLightboxImage.alt = image.alt;
        imageLightboxCaption.textContent =
          caption;
        document.body.dataset.lightboxOpen =
          "true";
        imageLightbox.showModal();
      };

      const imageLinks =
        document.querySelectorAll<HTMLAnchorElement>(
          ".home-screenshot__link",
        );

      for (const imageLink of imageLinks) {
        imageLink.addEventListener(
          "click",
          (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return;
            }

            event.preventDefault();
            openImageLightbox(imageLink);
          },
        );
      }

      imageLightboxClose?.addEventListener(
        "click",
        closeImageLightbox,
      );

      imageLightbox?.addEventListener(
        "click",
        (event) => {
          if (event.target === imageLightbox) {
            closeImageLightbox();
          }
        },
      );

      imageLightbox?.addEventListener(
        "close",
        () => {
          delete document.body.dataset
            .lightboxOpen;
          imageLightboxImage?.removeAttribute(
            "src",
          );
          imageLightboxTrigger?.focus();
          imageLightboxTrigger = undefined;
        },
      );
    </script>
  </body>
</html>
