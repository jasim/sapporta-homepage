---
import { Code } from "astro:components";
import { toAppHref } from "../app-links";
import BooksTableDataGrid from "../components/BooksTableDataGrid";
import HomepageActions from "../components/HomepageActions.astro";
import SapportaMark from "../components/SapportaMark.astro";
import "../styles/sapporta.css";
import "../styles/home3.css";
import { Code2, Table2 } from "lucide-react";

const title = "Sapporta";
const description =
  "Minimal markdown-style Sapporta homepage draft.";
const appBaseUrl =
  process.env.SAPPORTA_PUBLIC_APP_URL ?? "";
const codeTheme = "github-light-default";
const booksSchemaCode = `export const booksTable = sqliteTable("books", {
  id: integer("id").primaryKey({ autoIncrement: true }),
  title: text("title").notNull(),
  author: text("author").notNull(),
});

export const books = sapportaTable({
  drizzle: booksTable,
  meta: {
    label: "Books",
    rowScope: "systemGlobal",
    rowLabelColumns: ["title"],
    search: { columns: ["author", "title"] },
    children: [
      {
        table: "quotes",
        foreignKey: "book_id",
        label: "Quotes",
        columns: ["quote_text"],
        defaultSort: "-created_at",
      },
    ],
    columns: {
      title: { width: 64 },
      author: { width: 36 },
    },
  },
});`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="description"
      content={description}
    />
    <link
      rel="icon"
      href="/favicon.svg"
      type="image/svg+xml"
    />
    <title>{title}</title>
    <style>
      .draft-page {
        margin: 0;
        min-width: 20rem;
        padding-bottom: 0;
      }

      body.homepage.draft-page {
        padding-bottom: 0;
      }

      .home3-actions-wrap {
        box-sizing: border-box;
        margin: 0 auto;
        max-width: 96rem;
        padding-bottom: clamp(
          1.75rem,
          3.5vw,
          2.75rem
        );
        padding-top: clamp(2rem, 4vw, 3.5rem);
      }

      .home3-copy p,
      .home3-copy li {
        font-size: clamp(1.08rem, 1.3vw, 1.28rem);
        line-height: 1.62;
      }

      .home3-copy p {
        margin: 0;
      }

      .home3-copy p + p {
        margin-top: 1.1rem;
      }

      .homepage-offer {
        margin: 0 auto
          clamp(1.25rem, 2.4vw, 1.9rem);
        max-width: 40rem;
      }

      .homepage-offer-list {
        align-items: center;
        display: grid;
        gap: 0.68rem 1.35rem;
        grid-template-columns: repeat(
          3,
          minmax(0, 1fr)
        );
        justify-items: center;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .homepage-offer-item {
        align-items: center;
        background-image: linear-gradient(
          rgb(79 180 119 / 0.3),
          rgb(79 180 119 / 0.3)
        );
        background-position: 0 92%;
        background-repeat: no-repeat;
        background-size: 100% 0.16em;
        color: var(--sap-fg);
        display: inline-flex;
        font-size: clamp(0.92rem, 1.2vw, 1.04rem);
        font-weight: 710;
        justify-content: center;
        line-height: 1.3;
        position: relative;
        text-align: center;
        white-space: nowrap;
      }

      .home3-feature-grid {
        align-items: stretch;
        display: grid;
        gap: 1.35rem 1.45rem;
        grid-auto-rows: 1fr;
        grid-template-columns: repeat(
          2,
          minmax(0, 1fr)
        );
        list-style: none;
        margin: 2.25rem 0 4rem;
        padding: 0;
      }

      .home3-copy .home3-feature-grid {
        list-style: none;
        margin: 2.25rem 0 4rem;
        padding: 0;
      }

      .home3-copy-section {
        margin-top: clamp(2.75rem, 5vw, 4.5rem);
      }

      .home3-copy .home3-copy-section h2 {
        margin: 0 0 1rem;
      }

      .home3-copy-section-body {
        min-width: 0;
      }

      .home3-feature-card {
        background: transparent;
        border: 1px solid rgb(79 180 119 / 0.28);
        border-left-color: rgb(79 180 119 / 0.62);
        border-left-width: 3px;
        border-top-color: rgb(79 180 119 / 0.62);
        border-top-width: 3px;
        border-radius: 6px;
        box-shadow: inset 0 0 0 1px
          rgb(79 180 119 / 0.12);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        height: 100%;
        list-style: none;
        margin: 0;
        min-width: 0;
        padding: 0.95rem 1.05rem 0.95rem 1rem;
        width: 100%;
      }

      .home3-copy .home3-feature-card {
        font-size: 1rem;
        line-height: 1.4;
        margin: 0;
      }

      .home3-copy .home3-feature-card::marker {
        content: "";
      }

      .home3-feature-card-title {
        color: var(--sap-fg);
        display: block;
        font-size: 0.98rem;
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.2;
        margin-bottom: 0.42rem;
      }

      .home3-feature-card-text {
        color: var(--sap-fg-soft);
        display: block;
        font-size: 0.94rem;
        line-height: 1.42;
      }

      .homepage-footer {
        border-top: 1px solid var(--sap-border);
        color: var(--sap-fg-muted);
        margin-top: clamp(3.5rem, 7vw, 6rem);
        padding-bottom: clamp(2rem, 5vw, 3.5rem);
        padding-top: clamp(2rem, 4vw, 3rem);
      }

      .homepage-footer-inner {
        display: grid;
        gap: 2rem;
        grid-template-columns:
          minmax(0, 1.25fr)
          minmax(0, 1fr);
        margin: 0 auto;
        max-width: 96rem;
      }

      .homepage-footer-brand {
        max-width: 34rem;
      }

      .homepage-footer-title {
        align-items: center;
        color: var(--sap-fg);
        display: inline-flex;
        font-size: 0.86rem;
        font-weight: 800;
        gap: 0.48rem;
        letter-spacing: 0;
        line-height: 1;
        margin-bottom: 0.9rem;
        text-decoration: none;
        text-transform: uppercase;
      }

      .homepage-footer-mark {
        height: 1.32rem;
        width: 1.32rem;
      }

      .homepage-footer-copy {
        color: var(--sap-fg-soft);
        font-size: 0.94rem;
        line-height: 1.55;
        margin: 0;
      }

      .homepage-footer-copy
        + .homepage-footer-copy {
        margin-top: 0.72rem;
      }

      .homepage-footer-meta {
        color: var(--sap-fg-muted);
        font-size: 0.82rem;
      }

      .homepage-footer-grid {
        display: grid;
        gap: 1.5rem;
        grid-template-columns: repeat(
          3,
          minmax(0, 1fr)
        );
      }

      .homepage-footer-group-title {
        color: var(--sap-fg);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0;
        line-height: 1.2;
        margin: 0 0 0.7rem;
        text-transform: uppercase;
      }

      .homepage-footer-list {
        display: grid;
        gap: 0.52rem;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .homepage-footer-link {
        color: var(--sap-fg-soft);
        font-size: 0.9rem;
        font-weight: 570;
        line-height: 1.25;
        text-decoration: none;
        text-underline-offset: 0.2em;
      }

      .homepage-footer-link:hover {
        color: var(--sap-fg);
        text-decoration: underline;
        text-decoration-color: var(--sap-link);
        text-decoration-thickness: 1px;
      }

      @media (min-width: 68rem) {
        .home3-intro-layout .home3-copy {
          max-width: 96rem;
        }

        .home3-copy .home3-lede {
          margin-left: auto;
          margin-right: auto;
          max-width: 47rem;
        }

        .home3-copy .home3-feature-grid {
          margin: 2.25rem auto 4rem;
          max-width: 47rem;
        }

        .home3-copy-section {
          align-items: start;
          column-gap: 3.5rem;
          display: grid;
          grid-template-columns:
            minmax(13rem, 0.2fr)
            minmax(0, 1fr);
          margin-left: auto;
          margin-right: auto;
          width: 66.666%;
        }

        .home3-copy
          .home3-feature-grid
          + .home3-copy-section {
          margin-top: 0;
          padding-top: clamp(5rem, 7vw, 6.5rem);
        }

        .home3-copy .home3-copy-section h2 {
          margin-bottom: 0;
          text-align: right;
        }
      }

      @media (max-width: 36rem) {
        .home3-feature-grid {
          grid-template-columns: 1fr;
        }

        .homepage-footer-inner,
        .homepage-footer-grid {
          grid-template-columns: 1fr;
        }

        .homepage-offer-list {
          display: flex;
          flex-wrap: wrap;
          gap: 0.72rem 1rem;
          justify-content: center;
        }

        .homepage-offer-item {
          white-space: nowrap;
        }
      }
    </style>
  </head>
  <body class="homepage draft-page">
    <header
      class:list={[
        "homepage-header",
        "homepage-pad",
      ]}
    >
      <div class="homepage-header-inner">
        <a class="homepage-wordmark" href="/">
          <SapportaMark
            class="homepage-wordmark-icon"
            title=""
          />
          Sapporta
        </a>
        <nav
          class="homepage-nav"
          aria-label="Main navigation"
        >
          <a
            class="homepage-nav-link"
            href="/docs/getting-started/introduction/"
          >
            Documentation
          </a>
          <a
            class="homepage-nav-link"
            href="/grid/"
          >
            Sapporta Grid
          </a>
          <a
            class="homepage-nav-link"
            href="https://github.com/jasim/sapporta"
          >
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <section
      class:list={[
        "homepage-hero",
        "homepage-pad",
      ]}
      aria-labelledby="hero-title"
    >
      <article class="homepage-hero-copy">
        <div class="homepage-hero-heading">
          <SapportaMark
            class="homepage-hero-mark"
            title=""
          />
          <h1
            id="hero-title"
            class="homepage-title"
          >
            Sapporta
          </h1>
          <p class="homepage-subtitle">
            Build Database Applications in
            TypeScript
          </p>
        </div>
        <div class="homepage-hero-body">
          <div
            class="homepage-offer"
            aria-label="What Sapporta gives you"
          >
            <ul class="homepage-offer-list">
              <li class="homepage-offer-item">
                Editable data grids
              </li>
              <li class="homepage-offer-item">
                Generated REST APIs
              </li>
              <li class="homepage-offer-item">
                Forms and reports
              </li>
              <li class="homepage-offer-item">
                Row-scoped auth
              </li>
              <li class="homepage-offer-item">
                Agent-ready OpenAPI
              </li>
              <li class="homepage-offer-item">
                Integrated stack
              </li>
            </ul>
          </div>
          <HomepageActions />
        </div>
      </article>
    </section>

    <main>
      <section
        class:list={[
          "homepage-section",
          "homepage-section--showcase",
          "homepage-pad",
        ]}
        aria-label="Books table grid"
      >
        <div class="homepage-section-inner">
          <div class="home3-intro-layout">
            <div class="home3-demo">
              <input
                class="home3-demo-tab-input"
                type="radio"
                name="home3-demo-view"
                id="home3-demo-live"
                checked
              />
              <input
                class="home3-demo-tab-input"
                type="radio"
                name="home3-demo-view"
                id="home3-demo-code"
              />
              <div class="home3-demo-header">
                <div
                  class="home3-demo-tabs"
                  aria-label="Books demo view"
                >
                  <label
                    class="home3-demo-tab"
                    for="home3-demo-live"
                  >
                    <Table2
                      className="home3-demo-tab-icon"
                      aria-hidden="true"
                      size={17}
                      strokeWidth={2}
                    />
                    Live grid
                  </label>
                  <label
                    class="home3-demo-tab"
                    for="home3-demo-code"
                  >
                    <Code2
                      className="home3-demo-tab-icon"
                      aria-hidden="true"
                      size={17}
                      strokeWidth={2}
                    />
                    Schema code
                  </label>
                </div>
              </div>
              <div class="home3-demo-panels">
                <div
                  class="home3-demo-panel home3-demo-panel-live"
                >
                  <div class="homepage-grid-wrap">
                    <BooksTableDataGrid
                      client:only="react"
                    />
                  </div>
                </div>
                <div
                  class="home3-demo-panel home3-demo-panel-code"
                >
                  <figure
                    class="homepage-schema-panel"
                    aria-labelledby="books-schema-title"
                  >
                    <figcaption
                      class="homepage-schema-header"
                    >
                      <span
                        id="books-schema-title"
                        class="homepage-schema-path"
                      >
                        packages/api/schema/books.ts
                      </span>
                    </figcaption>
                    <div
                      class="homepage-schema-code"
                    >
                      <Code
                        code={booksSchemaCode}
                        lang="ts"
                        theme={codeTheme}
                      />
                    </div>
                  </figure>
                </div>
              </div>
            </div>

            <div
              class="home3-copy sl-markdown-content"
            >
              <p class="home3-lede">
                Sapporta helps you build
                applications that operate mostly
                on relational data - like personal
                databases, operational tools, and
                business software.
              </p>

              <ul class="home3-feature-grid">
                <li class="home3-feature-card">
                  <span
                    class="home3-feature-card-title"
                  >
                    Grids
                  </span>
                  <span
                    class="home3-feature-card-text"
                  >
                    Editable table UI with search,
                    sort, filters, nesting, and
                    keyboard flow.
                  </span>
                </li>
                <li class="home3-feature-card">
                  <span
                    class="home3-feature-card-title"
                  >
                    Reports
                  </span>
                  <span
                    class="home3-feature-card-text"
                  >
                    Summary rows, detail rows, and
                    drill-down links.
                  </span>
                </li>
                <li class="home3-feature-card">
                  <span
                    class="home3-feature-card-title"
                  >
                    REST APIs for every table
                  </span>
                  <span
                    class="home3-feature-card-text"
                  >
                    CRUD, lookup, count, export,
                    and typed custom endpoints.
                  </span>
                </li>
                <li class="home3-feature-card">
                  <span
                    class="home3-feature-card-title"
                  >
                    Forms
                  </span>
                  <span
                    class="home3-feature-card-text"
                  >
                    Validated data entry with
                    reliable keyboard navigation.
                  </span>
                </li>
                <li class="home3-feature-card">
                  <span
                    class="home3-feature-card-title"
                  >
                    Security
                  </span>
                  <span
                    class="home3-feature-card-text"
                  >
                    Workspace and role scoped
                    reads and writes.
                  </span>
                </li>
                <li class="home3-feature-card">
                  <span
                    class="home3-feature-card-title"
                  >
                    Deployment
                  </span>
                  <span
                    class="home3-feature-card-text"
                  >
                    Project wiring from <code
                      >npx sapporta init</code
                    > to production.
                  </span>
                </li>
              </ul>

              <section class="home3-copy-section">
                <h2>
                  The rich user experience of
                  collaborative databases
                </h2>

                <div
                  class="home3-copy-section-body"
                >
                  <p>
                    Just like creating a new
                    spreadsheet, in Sapporta, once
                    you define a table, you
                    immediately get a live
                    editable grid. The grid brings
                    a similar set of features and
                    UX as that of AirTable, NocoDB
                    and similar collaborative
                    databases. It is filterable,
                    sortable, and searchable. They
                    also support nested
                    master-detail relationships,
                    and full keyboard support that
                    work across levels.
                  </p>
                  <p>
                    The APIs used by the grid are
                    bounded by row-level security
                    and CASL authorization, and so
                    it can be shipped directly to
                    end users without additional
                    hardening.
                  </p>
                </div>
              </section>

              <section class="home3-copy-section">
                <h2>Not an opaque framework</h2>

                <div
                  class="home3-copy-section-body"
                >
                  <p>
                    There is no inversion of
                    control - Sapporta projects
                    are regular Hono APIs + React
                    single page applications that
                    your codebase owns completely.
                    There are no opaque
                    abstractions that obscures
                    control-flow or hide the
                    underlying implementation.
                  </p>
                </div>
              </section>

              <section class="home3-copy-section">
                <h2>Agentic development</h2>
                <div
                  class="home3-copy-section-body"
                >
                  <p>
                    Sapporta projects are
                    structured for coding agents.
                    The generated codebase follows
                    explicit conventions for
                    project structure. These
                    conventions cover data
                    modeling, API behavior, UI
                    flows, access rules, and
                    migrations. Sapporta also
                    ships
                    <a
                      href="https://github.com/jasim/sapporta-skills"
                      >sapporta-skills</a
                    >
                    for table creation, reports, row
                    access, custom endpoints, and frontend
                    workflows. The <a
                      href="https://github.com/jasim/legible-code"
                      >legible-code</a
                    >
                    skill applies domain types, module
                    boundaries, and the functional core,
                    imperative shell design to agent-authored
                    TypeScript.
                  </p>
                </div>
              </section>

              <section class="home3-copy-section">
                <h2>Type-safe APIs and auth</h2>
                <div
                  class="home3-copy-section-body"
                >
                  <p>
                    Every table exposes
                    auto-generated REST endpoints
                    (list, create, update etc.),
                    that adhere to row-level
                    security and CASL
                    authorization policies.
                  </p>
                  <p>
                    APIs don't require manual JSON
                    wiring for request/response
                    parsing. Both the
                    auto-generated APIs, as well
                    as any domain APIs you write,
                    are all defined using ts-rest.
                    The definitions go into <code
                      >packages/shared</code
                    >, and are immediately
                    available in the frontend as
                    typed functions.
                  </p>
                </div>
              </section>

              <section class="home3-copy-section">
                <h2>
                  Agentic use, out of the box
                </h2>
                <div
                  class="home3-copy-section-body"
                >
                  <p>
                    Applications that you build
                    with Sapporta can be operated
                    fully agentically by default.
                    Agents can insert new rows, or
                    update existing rows, map
                    freeform data into database
                    entries, execute multi-step
                    workflows, run reports, and
                    answer data questions, all
                    through the same APIs used by
                    the application UI.
                  </p>

                  <p>
                    For example, if you built an
                    Expense Tracking system with
                    Sapporta, then its users can
                    scribble reimbursement details
                    - rough vendor names, relative
                    dates, all in a freeform
                    structure - into an LLM agent,
                    and have it be recorded
                    accurately in the database.
                    This requires no additional
                    code (but the user needs to
                    have the <a
                      href="http://github.com/jasim/sapporta-skills"
                      >Sapporta skill</a
                    >
                    installed).
                  </p>

                  <p>
                    This works because Sapporta
                    publishes the application's
                    API surface at
                    <code>/api/openapi.json</code
                    >. It has detailed route
                    descriptions, usage examples,
                    and documented request
                    parameters for every available
                    endpoint. This includes all
                    the automatically generated
                    table APIs as well as any
                    domain specific APIs written
                    by you.
                  </p>

                  <p>
                    It is also secure by default -
                    since all endpoints are
                    secured by row-security and
                    CASL, the agents only have
                    access to the exact data that
                    the user themselves have.
                  </p>
                </div>
              </section>
            </div>
          </div>
        </div>
      </section>
    </main>

    <div class="home3-actions-wrap homepage-pad">
      <HomepageActions flush />
    </div>

    <footer class="homepage-footer homepage-pad">
      <div class="homepage-footer-inner">
        <div class="homepage-footer-brand">
          <a
            class="homepage-footer-title"
            href="/"
          >
            <SapportaMark
              class="homepage-footer-mark"
              title=""
            />
            Sapporta
          </a>
          <p class="homepage-footer-copy">
            Sapporta is an open-source toolkit for
            building TypeScript database
            applications with generated APIs,
            editable grids, forms, reports, and
            row-scoped auth. It is released under
            the MIT license.
          </p>
          <p
            class="homepage-footer-copy homepage-footer-meta"
          >
            Built and maintained by <a
              class="homepage-text-link"
              href="https://x.com/jasim_ab"
              >Jasim A Basheer</a
            >, <a
              class="homepage-text-link"
              href="https://protoship.io"
              >Protoship</a
            >.
          </p>
        </div>

        <div class="homepage-footer-grid">
          <nav aria-labelledby="footer-project">
            <h2
              id="footer-project"
              class="homepage-footer-group-title"
            >
              Project
            </h2>
            <ul class="homepage-footer-list">
              <li>
                <a
                  class="homepage-footer-link"
                  href="/docs/getting-started/introduction/"
                  >Documentation</a
                >
              </li>
              <li>
                <a
                  class="homepage-footer-link"
                  href="/grid/">Sapporta Grid</a
                >
              </li>
            </ul>
          </nav>

          <nav aria-labelledby="footer-source">
            <h2
              id="footer-source"
              class="homepage-footer-group-title"
            >
              Source
            </h2>
            <ul class="homepage-footer-list">
              <li>
                <a
                  class="homepage-footer-link"
                  href="https://github.com/jasim/sapporta"
                  >GitHub</a
                >
              </li>
              <li>
                <a
                  class="homepage-footer-link"
                  href="https://github.com/jasim/sapporta/issues"
                  >Issues</a
                >
              </li>
              <li>
                <a
                  class="homepage-footer-link"
                  href="https://github.com/jasim/sapporta/tree/main/packages/grid"
                  >Grid package</a
                >
              </li>
              <li>
                <a
                  class="homepage-footer-link"
                  href="https://github.com/jasim/sapporta/blob/main/LICENSE"
                  >MIT License</a
                >
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
