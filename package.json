{
  "name": "sapporta-homepage-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "clean-dist": "node scripts/clean-dist.mjs",
    "predev": "pnpm run clean-dist && pnpm --filter ./packages/shared build",
    "dev": "node --env-file=.env.development scripts/dev.mjs",
    "dev:server": "pnpm --filter ./packages/api dev",
    "dev:ui": "pnpm --filter ./packages/frontend dev",
    "seed:q1-2026": "node scripts/seed-q1-2026.mjs",
    "package-sources": "node scripts/package-source-switch.mjs",
    "package-sources:status": "node scripts/package-source-switch.mjs status",
    "package-sources:update-npm": "node scripts/package-source-switch.mjs update-npm",
    "package-sources:use-npm": "node scripts/package-source-switch.mjs use:npm",
    "package-sources:use-local": "node scripts/package-source-switch.mjs use:local",
    "prebuild": "pnpm run clean-dist",
    "build": "pnpm --filter ./packages/shared build && pnpm --filter ./packages/docs build && pnpm --filter ./packages/api build && pnpm --filter ./packages/frontend build",
    "start": "pnpm --filter ./packages/api start"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "@sapporta/honest": "link:///Users/jasim/m/a/code/sapporta/packages/honest",
      "@sapporta/shared": "link:///Users/jasim/m/a/code/sapporta/packages/shared",
      "@sapporta/ui": "link:///Users/jasim/m/a/code/sapporta/packages/ui",
      "@sapporta/grid": "link:///Users/jasim/m/a/code/sapporta/packages/grid",
      "hono": "4.12.29",
      "drizzle-orm": "0.45.2",
      "better-sqlite3": "12.11.1",
      "zod": "4.4.3",
      "@sapporta/rest-core": "3.52.2",
      "@js-temporal/polyfill": "0.5.1",
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "react-router-dom": "7.15.1",
      "zustand": "5.0.13",
      "@radix-ui/react-checkbox": "1.3.3",
      "@radix-ui/react-dialog": "1.1.15",
      "@radix-ui/react-label": "2.1.8",
      "@radix-ui/react-popover": "1.1.15",
      "@radix-ui/react-select": "2.2.6",
      "@radix-ui/react-switch": "1.2.6",
      "@hono/node-server": "2.0.6"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.1",
    "prettier-plugin-astro": "^0.14.1"
  }
}
